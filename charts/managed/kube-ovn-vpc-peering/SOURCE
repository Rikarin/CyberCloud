#
# ADR-010: "Their charts are a starting point, not a dependency. Where a chart is close, fork it into
# charts/ with the upstream commit recorded in a SOURCE file." Nothing was forked here — Kube-OVN is
# platform infrastructure installed once per cluster (ADR-019), and what this type writes is two
# slices of two tenant rows in that installation — and `vendored: none` is an answer to "where did
# this come from" where a missing file is not.

vendored: none
upstream: https://github.com/kubeovn/kube-ovn

# The upstream API the fragments target. ⚠ An API group/version, not a commit: nothing is vendored,
# so there is no upstream tree to pin.
upstream-api: kubeovn.io/v1

engine: https://github.com/ovn-org/ovn

