# The Node major is pinned by .nvmrc / .node-version and enforced as a hard gate
# by `pnpm node:gate` (scripts/check-node.mjs --strict), which CI runs first.
# engine-strict is deliberately left off so that a developer on a different Node
# gets a loud warning rather than an install that refuses to run — the gate is
# the wall, the warning is the nudge. See portal/README.md § Node.
engine-strict=false

# Angular's compiler resolves @angular/* deeply and @xui/* peers on exact
# @angular/* versions; a strict store layout surfaces a peer conflict at install
# time instead of as a runtime "two copies of Angular" failure.
strict-peer-dependencies=true
auto-install-peers=false
resolution-mode=highest
