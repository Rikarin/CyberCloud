# The Node major is pinned by .nvmrc / .node-version and enforced as a hard gate
# by `pnpm node:gate` (scripts/check-node.mjs --strict), which CI runs first.
# engine-strict is deliberately left off so that a developer on a different Node
# gets a loud warning rather than an install that refuses to run — the gate is
# the wall, the warning is the nudge. See portal/README.md § Node.
#
# ⚠ THE WALL HALF OF THAT SURVIVED CONTACT; THE NUDGE HALF DID NOT.
#
# Leaving engine-strict off is still right, and on this project it is not even a
# preference: the dev host has only Node 26 installed, so engine-strict=true
# would mean the portal cannot be installed at all. But "a loud warning" was
# measured and it was not loud — it fires once before the work, and the numbers
# a developer actually reads arrive minutes of build output later. A full
# session of portal figures was gathered on Node 26 and reported as pinned.
#
# The answer was not to move the wall here. It was scripts/check-node.mjs
# --recap (`pnpm node:recap`), which repeats the same fact *after* `pnpm test`
# and `pnpm build`, where the figures are. See that file's header.
engine-strict=false

# Angular's compiler resolves @angular/* deeply and @xui/* peers on exact
# @angular/* versions; a strict store layout surfaces a peer conflict at install
# time instead of as a runtime "two copies of Angular" failure.
strict-peer-dependencies=true
auto-install-peers=false
resolution-mode=highest
