{
  "name": "@cybercloud/portal-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^24.15.0",
    "pnpm": ">=11",
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm"
  },
  "scripts": {
    "node:check": "node scripts/check-node.mjs",
    "node:gate": "node scripts/check-node.mjs --strict",
    "lint": "eslint .",
    "test": "jest --ci",
    "test:watch": "jest --watch",
    "test:ssr": "node scripts/ssr-isolation.test.mjs",
    "test:ssr:identity": "node scripts/ssr-identity.test.mjs",
    "build": "pnpm node:check && ng build portal --configuration production && pnpm build:identity && pnpm budget && pnpm test:ssr && pnpm test:ssr:identity",
    "build:identity": "ng build identity --configuration production",
    "build:dev": "ng build portal --configuration development",
    "budget": "node scripts/bundle-budget.mjs",
    "serve": "ng serve portal",
    "serve:identity": "ng serve identity",
    "serve:ssr": "node dist/portal/server/server.mjs",
    "serve:ssr:identity": "node dist/identity/server/server.mjs",
    "i18n:extract": "ng extract-i18n portal --output-path apps/portal/src/locale --format xlf2",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "gates": "pnpm node:gate && pnpm verify"
  },
  "dependencies": {
    "@angular/common": "22.0.8",
    "@angular/compiler": "22.0.8",
    "@angular/core": "22.0.8",
    "@angular/forms": "22.0.8",
    "@angular/localize": "22.0.8",
    "@angular/platform-browser": "22.0.8",
    "@angular/platform-server": "22.0.8",
    "@angular/router": "22.0.8",
    "@angular/ssr": "22.0.8",
    "@angular/cdk": "22.0.6",
    "@ng-icons/core": "34.0.0",
    "@ng-icons/material-icons": "34.0.0",
    "@xui/breadcrumb": "2.2.1",
    "@xui/button": "2.2.1",
    "@xui/core": "2.2.1",
    "@xui/dialog": "2.2.1",
    "@xui/divider": "2.2.1",
    "@xui/dock-manager": "2.2.1",
    "@xui/icon": "2.2.1",
    "@xui/input": "2.2.1",
    "@xui/kbd": "2.2.1",
    "@xui/menu": "2.2.1",
    "@xui/non-ideal-state": "2.2.1",
    "@xui/omnibar": "2.2.1",
    "@xui/overflow-list": "2.2.1",
    "@xui/panel-stack": "2.2.1",
    "@xui/popover": "2.2.1",
    "@xui/progress-bar": "2.2.1",
    "@xui/scroll-area": "2.2.1",
    "@xui/select": "2.2.1",
    "@xui/spinner": "2.2.1",
    "@xui/tag": "2.2.1",
    "@xui/toast": "2.2.1",
    "@xui/tooltip": "2.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "5.2.1",
    "luxon": "3.7.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.6.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.0.8",
    "@angular/cli": "22.0.8",
    "@angular/compiler-cli": "22.0.8",
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.4",
    "@types/node": "24.13.3",
    "angular-eslint": "22.1.0",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "17.0.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "@tailwindcss/postcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
