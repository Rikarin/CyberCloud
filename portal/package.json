{
  "name": "@cybercloud/portal-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "budget": "node scripts/bundle-budget.mjs",
    "build": "pnpm node:check && pnpm forms:sync && ng build portal --configuration production && pnpm build:identity && pnpm budget && pnpm test:ssr && pnpm test:ssr:identity && pnpm node:recap",
    "build:dev": "pnpm forms:sync && ng build portal --configuration development",
    "build:identity": "ng build identity --configuration production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "forms:sync": "node scripts/sync-forms.mjs",
    "gates": "pnpm node:gate && pnpm verify",
    "i18n:extract": "ng extract-i18n portal --output-path apps/portal/src/locale --format xlf2",
    "lint": "eslint .",
    "node:check": "node scripts/check-node.mjs",
    "node:gate": "node scripts/check-node.mjs --strict",
    "node:recap": "node scripts/check-node.mjs --recap",
    "serve": "pnpm forms:sync && ng serve portal",
    "serve:identity": "ng serve identity",
    "serve:ssr": "node dist/portal/server/server.mjs",
    "serve:ssr:identity": "node dist/identity/server/server.mjs",
    "test": "pnpm node:check && jest --ci && pnpm node:recap",
    "test:ssr": "node scripts/ssr-isolation.test.mjs",
    "test:ssr:identity": "node scripts/ssr-identity.test.mjs",
    "test:watch": "jest --watch",
    "typecheck:api": "tsc -p libs/api/tsconfig.json",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck:api && pnpm test && pnpm build"
  },
  "dependencies": {
    "@angular/cdk": "22.1.4",
    "@angular/common": "22.1.4",
    "@angular/compiler": "22.1.4",
    "@angular/core": "22.1.4",
    "@angular/forms": "22.1.4",
    "@angular/localize": "22.1.4",
    "@angular/platform-browser": "22.1.4",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "22.1.4",
    "@angular/ssr": "22.1.6",
    "@microsoft/signalr": "10.0.11",
    "@ng-icons/core": "35.1.0",
    "@ng-icons/material-icons": "35.1.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xui/breadcrumb": "3.0.0",
    "@xui/button": "3.0.0",
    "@xui/callout": "3.0.0",
    "@xui/core": "3.0.0",
    "@xui/descriptions": "3.0.0",
    "@xui/dialog": "3.0.0",
    "@xui/divider": "3.0.0",
    "@xui/dock-manager": "3.0.0",
    "@xui/echarts": "3.0.0",
    "@xui/icon": "3.0.0",
    "@xui/input": "3.0.0",
    "@xui/kbd": "3.0.0",
    "@xui/menu": "3.0.0",
    "@xui/multi-select": "3.0.0",
    "@xui/non-ideal-state": "3.0.0",
    "@xui/numeric-input": "3.0.0",
    "@xui/omnibar": "3.0.0",
    "@xui/overflow-list": "3.0.0",
    "@xui/panel-stack": "3.0.0",
    "@xui/popover": "3.0.0",
    "@xui/progress-bar": "3.0.0",
    "@xui/scroll-area": "3.0.0",
    "@xui/select": "3.0.0",
    "@xui/spinner": "3.0.0",
    "@xui/switch": "3.0.0",
    "@xui/table": "3.0.0",
    "@xui/tag": "3.0.0",
    "@xui/tag-input": "3.0.0",
    "@xui/timeline": "3.0.0",
    "@xui/toast": "3.0.0",
    "@xui/tooltip": "3.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "express": "5.2.1",
    "luxon": "3.7.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.6.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.1.6",
    "@angular/cli": "22.1.6",
    "@angular/compiler-cli": "22.1.4",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.4",
    "@types/node": "24.13.3",
    "angular-eslint": "22.1.0",
    "axe-core": "4.13.0",
    "eslint": "10.8.1",
    "jest": "30.4.2",
    "jest-axe": "11.0.0",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "17.0.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "^24.15.0",
    "npm": "please-use-pnpm",
    "pnpm": ">=11",
    "yarn": "please-use-pnpm"
  }
}
