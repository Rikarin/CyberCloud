<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the fifth project: "the shared provider conformance suite,
      parameterised".

      ⚠ IT CONTAINS NO ASSERTIONS, AND IT IS THE SEVENTEENTH NAMESPACE TO TEST THAT CLAIM. What this one
      adds is a shape no earlier family had: a type with a POWER STATE that is not in its body, whose
      actions write the cluster, and whose reconciler reads the object before it renders.
      test/CyberCloud.Conformance still needed no change.

      ⚠ THIS PROJECT IS COUNTED BY THE Labels ARCHITECTURE GATE. Build.Architecture § LabelsGate runs
      EveryAppliedObjectCarriesTheSevenMandatoryLabelsAndBothAnnotations in every *.Conformance
      project under src/Providers.

      ⚠ IT REFERENCES A PROJECT UNDER test/, which docs/plan/03 § test/ intends: CyberCloud.Conformance
      is "the shared provider suite (parameterised, REFERENCED BY PROVIDERS)". docs/plan/03 § Assembly
      graph rules is about the shipped graph and excludes test projects by construction.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.Compute/CyberCloud.Providers.Compute.csproj"/>
        <ProjectReference Include="../../../../test/CyberCloud.Conformance/CyberCloud.Conformance.csproj"/>
    </ItemGroup>

</Project>
