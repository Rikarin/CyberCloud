<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The cluster-backed half of the shared provider conformance suite, run against the compute
      provider.

      ⚠ IT CONTAINS NO ASSERTIONS AND NO INFRASTRUCTURE. Everything it runs comes from
      test/CyberCloud.Cluster.Conformance; what lives here is class declarations over the SAME
      ProviderConformanceCase objects the Docker-free suite already uses.

      ⚠ WHAT THE k3s IT STARTS DOES NOT HAVE, SAID BEFORE ANY GREEN RUN IS READ: KubeVirt and CDI.
      ClusterConformanceHarness derives a minimal CRD stub per custom kind from the case's own Objects
      and waits for Established, which makes the REST path exist and nothing else. No VirtualMachine
      in this suite has ever had an instance, no DataVolume has ever been filled, and no webhook has
      ever admitted or refused a render. The half that needs the real operators is
      test/CyberCloud.Bundle.Cluster.Conformance § KubeVirtOnAnEmptyCluster, which installs both
      through charts/bundle/install.sh, applies charts/managed/image and charts/managed/
      virtual-machine against them, and reads the guest Running — see ComputeClusterBackedConformance.

      ⚠ IT IS NOT NAMED `.Conformance.Cluster`, for the reason every sibling gives: Directory.Build.props
      § Project role detection and build/Build.Test.cs § SuiteOwning both classify by the SUFFIX, and
      `.Cluster.Conformance` is claimed by both with no edit to either file.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          ⚠ The CASES come from the provider's Docker-free conformance project rather than being
          declared again here. One resource type, one ProviderConformanceCase.
        -->
        <ProjectReference Include="../CyberCloud.Providers.Compute.Conformance/CyberCloud.Providers.Compute.Conformance.csproj"/>
        <ProjectReference Include="../../../../test/CyberCloud.Cluster.Conformance/CyberCloud.Cluster.Conformance.csproj"/>
    </ItemGroup>

</Project>
