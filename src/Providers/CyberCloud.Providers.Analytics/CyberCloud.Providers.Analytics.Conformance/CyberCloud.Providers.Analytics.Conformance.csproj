<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the fifth project: "the shared provider conformance suite,
      parameterised".

      ⚠ IT CONTAINS NO ASSERTIONS, AND IT IS THE FIFTH NAMESPACE TO TEST THAT CLAIM. The extremes are
      already bracketed — CyberCloud.Messaging/natsClusters renders five objects across three groups,
      CyberCloud.Storage/accounts renders one — so what this one adds is neither end of the range but
      a shape none of them had: TWO objects in TWO API GROUPS where one names a Service of the other.
      test/CyberCloud.Conformance still needed no change.

      ⚠ THIS PROJECT IS THE SIXTH SUITE THE Labels ARCHITECTURE GATE COUNTS. Build.Architecture
      § LabelsGate runs EveryAppliedObjectCarriesTheSevenMandatoryLabelsAndBothAnnotations in every
      *.Conformance project under src/Providers.

      ⚠ IT REFERENCES A PROJECT UNDER test/, which docs/plan/03 § test/ intends: CyberCloud.Conformance
      is "the shared provider suite (parameterised, REFERENCED BY PROVIDERS)". docs/plan/03 § Assembly
      graph rules is about the shipped graph and excludes test projects by construction.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.Analytics/CyberCloud.Providers.Analytics.csproj"/>
        <ProjectReference Include="../../../../test/CyberCloud.Conformance/CyberCloud.Conformance.csproj"/>
    </ItemGroup>

</Project>
