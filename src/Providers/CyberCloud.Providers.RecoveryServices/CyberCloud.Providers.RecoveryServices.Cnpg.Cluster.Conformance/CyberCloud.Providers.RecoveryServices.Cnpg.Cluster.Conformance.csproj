<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The vault against the REAL CloudNativePG — installed onto the shared k3s by
      charts/bundle/install.sh before anything else in this process runs.

      ⚠ THE FIRST TEST PROJECT UNDER src/Providers THAT INSTALLS A BUNDLE COMPONENT, AND A PROCESS OF
      ITS OWN. Every *.Cluster.Conformance lane applies its custom resources against a CRD stub the
      harness derives; this one runs `install.sh` for cloudnative-pg and openebs-localpv first, so the
      harness finds postgresql.cnpg.io/v1 served and derives no stub. It cannot share a process with
      CyberCloud.Providers.RecoveryServices.Cluster.Conformance: whichever class ran first would leave
      the other either with stubs helm refuses to install over, or with a real definition that refuses
      the PostgreSQL family's default body (charts/managed/postgres/conformance.yaml § owed,
      `the-default-bucket-is-not-filled-in`). One k3s per process — ClusterSlot — is the boundary.

      ⚠ WHAT IT PROVES, SINCE #30: THE WHOLE ROUND TRIP. A PostgreSQL server with backups on archives
      to a bucket of its own on a real SeaweedFS (the platform's object store, started beside k3s),
      with a key issued by the store's IAM API and held in the vault; a vault protects it; backupNow
      completes; recover creates a NEW server resource through the caller's write path; and the row
      written before the backup is in the restored database. The first cut of this lane could only
      assert the vault's refusal of a backups-off server, because the chart rendered a store with no
      credentials and the operator's webhook refused every server with backups on.

      ⚠ IT REFERENCES CyberCloud.ObjectStorage — the shipping SeaweedFsObjectStoreGrants the silo is
      given, and the S3 client that reads the bucket back.

      ⚠ IT REFERENCES test/CyberCloud.Bundle.Cluster.Conformance FOR BundleInstaller — the one place
      install.sh is run from managed code. A second runner here would be a second reading of
      install.sh's arguments.

      ⚠ NAMED `.Cnpg.Cluster.Conformance`: the `.Cluster.Conformance` suffix is what keeps it out of
      the Labels gate's per-project run and classifies it as a test host.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.RecoveryServices.Conformance/CyberCloud.Providers.RecoveryServices.Conformance.csproj"/>
        <ProjectReference Include="../../../../test/CyberCloud.Cluster.Conformance/CyberCloud.Cluster.Conformance.csproj"/>
        <ProjectReference Include="../../../../test/CyberCloud.Bundle.Cluster.Conformance/CyberCloud.Bundle.Cluster.Conformance.csproj"/>
        <ProjectReference Include="../../../CyberCloud.ObjectStorage/CyberCloud.ObjectStorage.csproj"/>
    </ItemGroup>

</Project>
