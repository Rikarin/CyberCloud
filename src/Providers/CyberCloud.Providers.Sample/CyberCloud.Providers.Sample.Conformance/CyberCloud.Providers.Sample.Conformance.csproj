<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the fifth project: "the shared provider conformance suite,
      parameterised".

      ⚠ IT CONTAINS NO ASSERTIONS. Everything it runs comes from test/CyberCloud.Conformance; what
      lives here is one ProviderConformanceCase and two class declarations. That is the shape the
      catalogue needs: the twentieth provider costs the same as the first, and a provider cannot
      soften an assertion by rewriting it locally, because there is nothing local to rewrite.

      ⚠ IT REFERENCES A PROJECT UNDER test/, WHICH IS BACKWARDS-LOOKING AND IS THE DOCUMENT'S SHAPE.
      docs/plan/03 § test/ calls CyberCloud.Conformance "the shared provider suite (parameterised,
      REFERENCED BY PROVIDERS)". docs/plan/03 § Assembly graph rules is about the shipped graph and
      excludes test projects by construction (Build.Test.cs § SuiteOwning is the same classifier), so
      this reference is outside every rule there.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.csproj"/>
        <ProjectReference Include="../../../../test/CyberCloud.Conformance/CyberCloud.Conformance.csproj"/>
    </ItemGroup>

</Project>
