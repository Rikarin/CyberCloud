<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the implementation assembly: "grains, reconcilers, the chart
      bindings". Five reconcilers and five chart bindings; no grain, for the reason the .Contracts
      .csproj gives.

      ⚠ ITS ENTIRE REFERENCE SET IS ITS OWN .Contracts. Everything else — IResourceReconciler,
      ReconcileContext, KubeCommand — arrives through it.

      ⚠ NO KubernetesClient. docs/plan/03 § Assembly graph rules, rule 3: nothing above
      CyberCloud.Kubernetes names a k8s.Models type. Every object this family renders is a Kube-OVN
      custom resource, which has no k8s.Models type anyway, and building them as JsonObject is what
      keeps that true without anyone having to remember it.
    -->

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.Network.Contracts/CyberCloud.Providers.Network.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup Label="CyberCloud.Analyzers — see CyberCloud.Core.csproj for why this is not a reference">
        <ProjectReference Include="../../../CyberCloud.Analyzers/CyberCloud.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
