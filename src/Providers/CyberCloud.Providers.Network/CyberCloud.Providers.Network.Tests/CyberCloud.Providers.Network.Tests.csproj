<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the fourth project: "TestCluster + k3s".

      ⚠ NEITHER, HERE, for the reason every family before this one records: the TestCluster half is
      test/CyberCloud.Conformance's and the k3s half is
      CyberCloud.Providers.Network.Cluster.Conformance's. What is left is what only THIS provider can
      be wrong about — and on this family that list is longer than usual, because the one thing this
      provider most needs checked is the thing ResourceSchema cannot express: a CIDR that overlaps the
      platform's underlay. NetworkAddressTests is that test, and it is the largest file here.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.Network/CyberCloud.Providers.Network.csproj"/>
        <!-- ProviderRegistry.Build, so the declaration is checked the way a silo checks it at start. -->
        <ProjectReference Include="../../../CyberCloud.ResourceManager/CyberCloud.ResourceManager.csproj"/>
    </ItemGroup>

</Project>
