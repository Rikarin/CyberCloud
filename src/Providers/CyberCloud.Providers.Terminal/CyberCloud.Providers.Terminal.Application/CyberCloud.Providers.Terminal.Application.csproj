<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the third of the five projects: "ABP application services the gateway
      routes to".

      ⚠ IT HOLDS THE ABP MODULE AND NO APPLICATION SERVICE, AND THIS IS THE TWELFTH PROVIDER TO REPORT
      THAT — but the first for which the sentence needed checking rather than repeating. A console's
      product is an interactive session, so this family was the obvious candidate for a bespoke
      controller: something has to carry bytes between a browser and a pod. It does not go here.
      docs/plan/10 § SignalR routes the terminal to `/hubs/terminal`, which is the GATEWAY's own
      endpoint and is already mapped; a hub is not an ABP application service and would not be routed
      from the provider registry if it were. So PUT, GET, DELETE, POST connect and POST terminate stay
      generic resource-manager verbs (ADR-012), and the byte path stays where docs/plan/10 put it.

      ⚠ Rule 4 of docs/plan/03 § Assembly graph rules ("nothing references a *.Application assembly")
      is enforced more weakly than the document states — Build.Architecture.cs § AssemblyGraphGate,
      rule 4, says so in its own report — and a twelfth candidate does not fix that.
    -->

    <ItemGroup>
        <PackageReference Include="Volo.Abp.Ddd.Application"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.Terminal.Contracts/CyberCloud.Providers.Terminal.Contracts.csproj"/>
        <!--
          ⚠ THE IMPLEMENTATION ASSEMBLY, AND THIS LINE IS WHAT MAKES THE MODULE BELOW WORTH LOADING.
          docs/plan/03 § Providers: "each registers its resource types into CyberCloud.ResourceManager".
          The provider class lives next door, so registering it means naming it, and rule 2 has nothing
          to say about a reference inside one family. Rule 5 keeps the gateway off the implementation
          assembly and it still holds: the gateway references THIS project, binds the module type, and
          binds nothing from the implementation.
        -->
        <ProjectReference Include="../CyberCloud.Providers.Terminal/CyberCloud.Providers.Terminal.csproj"/>
        <!--
          ⚠ AddCyberCloudProvider LIVES IN THE IMPLEMENTATION ASSEMBLY, NOT IN .Contracts, because
          what it registers is what the provider's Describe declared — the reconciler and handler types
          DiscoveringProviderBuilder walks. This provider is the first whose Describe declares BOTH,
          which makes the handler half of that walk non-vacuous for a shipping family.
        -->
        <ProjectReference Include="../../../CyberCloud.ResourceManager/CyberCloud.ResourceManager.csproj"/>
    </ItemGroup>

    <ItemGroup Label="CyberCloud.Analyzers — see CyberCloud.Core.csproj for why this is not a reference">
        <ProjectReference Include="../../../CyberCloud.Analyzers/CyberCloud.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
