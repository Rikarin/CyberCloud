<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the fourth project: "TestCluster + k3s".

      ⚠ NEITHER, HERE. The TestCluster half is test/CyberCloud.Conformance's, because a provider's
      lifecycle is the SHARED suite's assertion, and the k3s half is this provider's
      *.Cluster.Conformance project. What is left is what only THIS provider can be wrong about: its
      declaration, its HarborCluster projection, its containment comparison, its quota arithmetic, its
      credential ordering, and its reconciler's behaviour against a connection it does not control.

      ⚠ IT EMBEDS TWO FILES FROM charts/managed/harbor/, and the row-by-row schema comparison is NOT
      one of the reasons. `./build.sh Charts` generates the chart's @param block from the registry and
      byte-diffs it, so comparing the two here would be comparing a file with the file it was generated
      from. What generation does not reach is templates/ — ChartSurfaces filters it out on purpose, no
      emitter has ever read a Helm template — so the preset table comparison lives here; and the
      ANCHORING of an emitted `pattern`, which is a property of the shipped values.schema.json that
      neither half of the round trip can assert on its own.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
        <!--
          ⚠ A TestCluster after all, and only for the grain. The header above says the lifecycle
          belongs to the shared suite, and it still does; what the shared suite cannot ask is
          whether FeedGrain's own rules hold — immutable versions, a sticky close, a refused
          reopening — because it drives the reconciler and not the catalogue. FeedGrainTests asks
          those of the real grain in an in-memory silo, and ArtifactFeedReconcilerTests drives the
          reconciler against a substituted catalogue so its branches can be reached one at a time.
        -->
        <PackageReference Include="Microsoft.Orleans.TestingHost"/>
        <PackageReference Include="Orleans.Multitenant"/>
        <PackageReference Include="NSubstitute"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup Label="The other half of the pair — see the header">
        <EmbeddedResource Include="../../../../charts/managed/harbor/values.schema.json"
                          LogicalName="harbor.values.schema.json"/>
        <EmbeddedResource Include="../../../../charts/managed/harbor/templates/_helpers.tpl"
                          LogicalName="harbor.helpers.tpl"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.ContainerRegistry/CyberCloud.Providers.ContainerRegistry.csproj"/>
        <!-- ProviderRegistry.Build, so the declaration is checked the way a silo checks it at start. -->
        <ProjectReference Include="../../../CyberCloud.ResourceManager/CyberCloud.ResourceManager.csproj"/>
    </ItemGroup>

</Project>
