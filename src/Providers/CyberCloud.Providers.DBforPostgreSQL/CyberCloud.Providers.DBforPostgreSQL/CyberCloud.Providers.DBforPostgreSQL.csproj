<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the implementation assembly: "grains, reconcilers, the chart
      bindings". This one has a reconciler and a chart binding, and no grain (see the .Contracts
      .csproj for why the absence is a finding rather than an omission).

      ⚠ ITS ENTIRE REFERENCE SET IS ITS OWN .Contracts, exactly as the sample's is. Everything else —
      IResourceReconciler, ReconcileContext, KubeCommand — arrives through it. docs/plan/07 § The
      enforcement seam: "Providers never call the engine." Here that is mechanical rather than
      reviewed, because CyberCloud.ResourceManager.Contracts does not reference
      CyberCloud.Authorization.Contracts, so ICheckGrain is not nameable from this assembly at all.

      ⚠ NO KubernetesClient. docs/plan/03 § Assembly graph rules, rule 3: nothing above
      CyberCloud.Kubernetes names a k8s.Models type. A CloudNativePG Cluster has no k8s.Models type
      anyway — it is a custom resource — and building it as JsonObject rather than as a generated CRD
      model is what keeps that true without anyone having to remember it.
    -->

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.DBforPostgreSQL.Contracts/CyberCloud.Providers.DBforPostgreSQL.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup Label="CyberCloud.Analyzers — see CyberCloud.Core.csproj for why this is not a reference">
        <ProjectReference Include="../../../CyberCloud.Analyzers/CyberCloud.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
