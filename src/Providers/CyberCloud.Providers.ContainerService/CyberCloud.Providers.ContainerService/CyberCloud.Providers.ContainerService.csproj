<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Providers — the implementation assembly: "grains, reconcilers, the chart
      bindings". Two reconcilers and two chart bindings; no grain, for the reason the .Contracts
      .csproj gives.

      ⚠ ITS ENTIRE REFERENCE SET IS ITS OWN .Contracts. Everything else — IResourceReconciler,
      ReconcileContext, KubeCommand — arrives through it. docs/plan/07 § The enforcement seam:
      "Providers never call the engine", which here is mechanical rather than reviewed, because
      CyberCloud.ResourceManager.Contracts does not reference CyberCloud.Authorization.Contracts and
      ICheckGrain is therefore not nameable from this assembly at all.

      ⚠ NO KubernetesClient, AND THIS IS THE FAMILY WHERE THAT RULE IS MOST TEMPTING TO BREAK.
      docs/plan/03 § Assembly graph rules, rule 3: nothing above CyberCloud.Kubernetes names a
      k8s.Models type. Cluster API, Kamaji and the KubeVirt infrastructure provider all ship
      generated Go types and there are C# ports of some of them; every object this provider renders
      is built as a JsonObject instead, which is what keeps rule 3 true without anyone having to
      remember it.
    -->

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Providers.ContainerService.Contracts/CyberCloud.Providers.ContainerService.Contracts.csproj"/>
    </ItemGroup>

    <ItemGroup Label="CyberCloud.Analyzers — see CyberCloud.Core.csproj for why this is not a reference">
        <ProjectReference Include="../../../CyberCloud.Analyzers/CyberCloud.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
