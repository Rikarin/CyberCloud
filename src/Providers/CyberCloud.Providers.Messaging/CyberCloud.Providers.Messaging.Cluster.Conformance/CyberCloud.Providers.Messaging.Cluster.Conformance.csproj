<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The cluster-backed half of the shared provider conformance suite, run against the managed-Kafka
      provider.

      ⚠ IT CONTAINS NO ASSERTIONS AND NO INFRASTRUCTURE. Everything it runs comes from
      test/CyberCloud.Cluster.Conformance; what lives here is two class declarations over the SAME
      ProviderConformanceCase the Docker-free suite already uses.

      ⚠ IT IS THE SECOND PROJECT OF ITS KIND AND THE FIRST WHOSE OBJECTS ARE CUSTOM RESOURCES, AND
      THAT IS WHAT IT MEASURED. The sample's renders a core-group ConfigMap, whose REST path the API
      server serves without being told. A Strimzi Kafka's does not exist on a bare k3s at all — and
      the failure is not a 404: the client cannot discover the group, so it throws
      k8s.Autorest.HttpOperationException with NO status code, naming neither the missing definition
      nor the provider. Five of the six tests in this assembly failed that way before the harness
      installed definitions. It now derives them from the case's own Objects — see
      ClusterConformanceHarness.EnsureCustomResourceDefinitionsAsync for why deriving beats declaring.

      ⚠ IT IS A SEPARATE PROJECT FROM CyberCloud.Providers.Messaging.Conformance, AND THAT IS THE
      WHOLE SPLIT. That project must keep running on a machine with no Docker — it is the per-PR gate
      for every provider change. Adding Testcontainers to it would make the twelve-step write path,
      the verb grammar, the four reconciler clauses and the cross-tenant 404 all unrunnable without a
      daemon.

      ⚠ IT IS NOT NAMED `.Conformance.Cluster`. Directory.Build.props § Project role detection and
      build/Build.Test.cs § SuiteOwning both classify by the SUFFIX of the project name; a name ending
      in `.Cluster` is claimed by neither, so the project would build as a library rather than as a
      test host. `.Cluster.Conformance` is claimed by both with no edit to either file.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          ⚠ The CASE comes from the provider's Docker-free conformance project rather than being
          declared again here. One provider, one ProviderConformanceCase: a second copy would be a
          second description of the same provider, and the two would disagree the first time either
          changed.
        -->
        <ProjectReference
            Include="../CyberCloud.Providers.Messaging.Conformance/CyberCloud.Providers.Messaging.Conformance.csproj"/>
        <ProjectReference Include="../../../../test/CyberCloud.Cluster.Conformance/CyberCloud.Cluster.Conformance.csproj"/>
    </ItemGroup>

</Project>
