<Project Sdk="Microsoft.NET.Sdk">

  <!--
    docs/plan/02 ADR-018: tests are siblings. OutputType=Exe and the Microsoft.Testing.Platform
    switches come from the repository-root Directory.Build.props / .targets — do not repeat them
    here, and do NOT add Microsoft.NET.Test.Sdk.

    FrameworkReference Microsoft.AspNetCore.App because SiloHostTests starts a real WebApplication
    and talks to it over HTTP. That is the point of the file: a health check can only be shown not to
    lie by asking it the way Kubernetes asks it.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
    <!--
      ABP, for one reason only: CreateSilo calls builder.Host.UseAutofac() per docs/plan/04:44, and
      ABP's service-provider factory demands an IModuleContainer at Build() time. SiloHostTests
      therefore has to register a real (empty) AbpModule, which is also what makes the test a proof
      of the documented startup sequence rather than of a convenient subset of it.
    -->
    <PackageReference Include="Volo.Abp.Autofac" />
  </ItemGroup>

  <ItemGroup Label="Global usings">
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CyberCloud.ServiceDefaults/CyberCloud.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
