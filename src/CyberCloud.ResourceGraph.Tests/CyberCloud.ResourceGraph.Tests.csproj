<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The resource-changed stream and the resource-graph projection — issue #54's tests.

        SubjectGrammarTests         — docs/plan/04 § Streams' subject, token by token: a provider's dot
                                      and a child type's slash fold into one token each, the tenant is
                                      always the second token and reads back, and no name can widen a
                                      filter
        ResourceChangedJsonTests    — the event survives the wire as JSON: enums by name, the tag map,
                                      the timestamps, and the two computed properties left out
        ClickHouseRowJsonTests      — a row round-trips ClickHouse's own JSONEachRow spelling of a
                                      DateTime64 and a quoted UInt64
        ProjectionRoundTripTests    — the whole path against a REAL NATS with JetStream and a REAL
                                      ClickHouse, both in containers, with the projector running as a
                                      hosted service inside a TestCluster silo whose authorization
                                      grains fill the access column: publish through the sink, read the
                                      row back; replay the same version and a lower one and hold one
                                      row; a Deleted event tombstones; a retried publish is one message

      The query half (Query/):

        KqlTranslationGoldenTests   — every Query/Golden/*.kql translated against one tenant, one
                                      caller and one page, compared byte for byte to the .sql beside
                                      it; CYBERCLOUD_UPDATE_GOLDEN=1 rewrites and the diff is the review
        KqlRefusalTests             — everything outside the subset is refused by the token it names,
                                      with the supported list in the message; and the four sizes that
                                      would overflow a stack — tokens, bracket nesting, operators,
                                      expression depth — are refused by their number before the
                                      parser runs
        ResourceGraphQueryFailureTests — what a caller reads when the store refuses the statement:
                                      one sentence and never ClickHouse's, which quotes the statement
                                      and the caller's usersets back; a budget refusal is a 400 that
                                      names the budget; the detail is in the log
        KqlInjectionTests           — a string literal is a parameter whatever it holds: a payload
                                      with a quote, a semicolon and a DROP is bound and never SQL text
        ResourceGraphContinuationTests — the $skipToken is an offset tied to one query's text
        ResourceGraphQueryServiceTests — the query API over the REAL projection: rows the real
                                      projector wrote, the caller's usersets from the real membership
                                      index, every translator shape accepted by ClickHouse 25.3

      ⚠ The container suite needs a Docker daemon, like CyberCloud.ObjectStorage.Tests' SeaweedFS. It
      is the only evidence in the tree that the subject grammar, the JetStream declaration, the
      ClickHouse DDL and the JSONEachRow spelling agree with the real servers; the Docker-free tests
      prove agreement with this repository's own reading of their documentation, which is not the
      same thing.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="Microsoft.Orleans.TestingHost"/>
        <PackageReference Include="Orleans.Multitenant"/>
        <PackageReference Include="NATS.Client.JetStream"/>
    </ItemGroup>

    <ItemGroup Label="A real NATS and a real ClickHouse — docs/plan/23 § Test layers">
        <!-- The generic ContainerBuilder: there is no Testcontainers.Nats or .ClickHouse pinned here. -->
        <PackageReference Include="Testcontainers"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.ResourceGraph/CyberCloud.ResourceGraph.csproj"/>
        <!-- The real CheckGrain and TupleStoreGrain, so the access column is filled by the engine and not a double. -->
        <ProjectReference Include="../CyberCloud.Authorization/CyberCloud.Authorization.csproj"/>
        <ProjectReference Include="../CyberCloud.Core.Contracts/CyberCloud.Core.Contracts.csproj"/>
    </ItemGroup>

</Project>
