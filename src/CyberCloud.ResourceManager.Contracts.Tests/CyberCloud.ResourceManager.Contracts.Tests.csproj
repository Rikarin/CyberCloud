<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The pure half of the resource manager's tests: schema validation, api-version parsing and
      projection, the closed ReconcileOutcome, the backoff arithmetic and the 60-minute timeout
      message, and the write-trace ordering invariant.

      ⚠ NO Testcontainers AND NO Aspire.Hosting HERE, AND NONE IS NEEDED. Nothing in this project
      touches a grain, so ADR-018's "real storage" rule does not reach it — that rule is about grain
      behaviour, and these are value types with no storage at all. The grain-backed half is
      CyberCloud.ResourceManager.Tests, which does have something to say about it.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup Label="The other end of the chart-annotation round trip — see ChartAnnotationTests">
        <!--
          ⚠ THE READER, AS TEXT, AND THAT IS THE ONLY WAY TO REACH IT. build/_build.csproj is
          deliberately outside the solution and references nothing in src/, so no test assembly can
          call the annotated-values reader. But the reader's directive table and the emitter's are two
          hand-maintained copies of one list, and a directive in one and not the other is a fact that
          reaches an API and not a chart — silently, because both halves still compile. Embedding the
          source lets ChartAnnotationTests read the tables out of it and fail when they diverge. It is
          the same trick CyberCloud.Providers.DBforPostgreSQL.Tests uses to reach values.schema.json.
        -->
        <EmbeddedResource Include="../../build/Build.Charts.cs" LogicalName="build.Build.Charts.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.ResourceManager.Contracts/CyberCloud.ResourceManager.Contracts.csproj"/>
    </ItemGroup>

</Project>
