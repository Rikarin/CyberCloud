<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The identity host's security boundaries and its grants, asserted against the host's REAL
      registrations and — for the grants — the real host on a socket:

        IdentityHostAuthenticationTests — a session cookie is a credential here and a bearer token is
                                          not, which is docs/plan/11 § Hosts' whole reason for two
                                          hosts on two origins
        NoRolesInTokenTests             — the principal an access token is built from carries no role
                                          or permission claim, and the refresh-only claims never
                                          reach it
        AuthorizeHandlerTests           — what /authorize does with a cookie: which cookies get a
                                          code, which go back to the sign-in page, and which client
                                          ids no tenant can shadow
        TokenApiTests                   — the three grants' decisions: client credentials over a
                                          vault double, the code exchange and the refresh over real
                                          session grains
        GrantsOverHttpTests             — the person's whole path over HTTP: password, delivered
                                          code, /authorize, /token with PKCE, the refresh cookie and
                                          its Origin rule, the replay, /logout, and a restart on the
                                          same key directory
        DeviceFlowOverHttpTests         — RFC 8628 (#43): /device, the device page's API, every
                                          answer /token gives a poll, the refresh and /revoke
        DeviceFlowThroughTheSdkTests    — the SDK's device credential, refresh and sign-out, the
                                          protocol half of `cyc login` and `cyc logout`, against
                                          this host

      ⚠ NO TestServer AND NO WebApplicationFactory, AND THAT IS A DELIBERATE CHOICE RATHER THAN A
      MISSING PACKAGE. Both would need Microsoft.AspNetCore.Mvc.Testing, which docs/plan/02's
      dependency register does not list. The boundary suites ask their question of the service
      collection, which can be asked directly and answered exactly; the grant suites start the real
      composition — IdentityComposition.BuildAsync, the call Program.cs makes — on 127.0.0.1:0 as a
      client of an in-process Orleans TestCluster with memory storage, which is the arrangement
      CyberCloud.Registry.Feeds.Host.Tests uses for the feeds host and what lets an HttpClient drive
      OpenIddict's pipeline end to end without Docker, Aspire or the AppHost.

      What that still does not cover, stated so it can be paid rather than forgotten: the gateway
      validating a code-grant token against this host's JWKS is CyberCloud.AppHost.Tests'
      TenantOverHttpTests', and the person half of that story — the same path with the gateway on the
      far end — lands there.
    -->

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="Microsoft.Orleans.TestingHost"/>
        <PackageReference Include="Orleans.Multitenant"/>
        <!-- #43: the invitation suite's Mailpit — the generic builder, as CyberCloud.Communication.Tests uses, because there is no Testcontainers.Mailpit. -->
        <PackageReference Include="Testcontainers"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../CyberCloud.Identity.Host/CyberCloud.Identity.Host.csproj"/>
        <!-- The silo half of the grant suites: the identity grains, the tenancy grains the host resolves a tenant and a client through, and the engine the identity module composes beside. -->
        <ProjectReference Include="../../CyberCloud.Identity/CyberCloud.Identity.csproj"/>
        <ProjectReference Include="../../CyberCloud.Tenancy/CyberCloud.Tenancy.csproj"/>
        <ProjectReference Include="../../CyberCloud.Authorization/CyberCloud.Authorization.csproj"/>
        <!-- #43: cyc login's protocol half, run against this host rather than a scripted server — DeviceFlowThroughTheSdkTests says what the scripted one had agreed to that this host did not. -->
        <ProjectReference Include="../../CyberCloud.Sdk/CyberCloud.Sdk.csproj"/>
        <!-- #43: the mail path the invitation suite runs for real — the communication module and its SMTP carrier, in the silo. -->
        <ProjectReference Include="../../CyberCloud.Communication/CyberCloud.Communication.csproj"/>
    </ItemGroup>

</Project>
