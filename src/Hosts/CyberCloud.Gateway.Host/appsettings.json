{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Orleans": "Warning",
        "Volo.Abp": "Warning"
      }
    }
  },
  "CyberCloud": {
    "Gateway": {
      "Region": "",
      "PublicBaseUri": "https://api.cybercloud.io",
      "CurrentApiVersion": "2026-08-01",
      "Identity": {
        "Issuer": "https://id.cybercloud.io",
        "Audience": "cyc.api"
      }
    }
  },
  "AllowedHosts": "*"
}
