<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Hosts and docs/plan/10 — the one public entry point. An ASP.NET Core app and an
      Orleans CLIENT (OrleansApplication.CreateClient), never a silo, so a gateway deploy does not
      move grains.

      ⚠ THE REFERENCE SET IS PART OF THE SECURITY ARGUMENT, IN BOTH DIRECTIONS.

      What is here, and why each one has to be:

        CyberCloud.Analyzers            CC1006. docs/plan/00 § The tenant-separation row, corrected:
                                        "the gateway does not exist yet, and when it does, adding the
                                        analyzer reference to it is what makes this row true for the
                                        caller it is actually about". Without this line the Analyzer
                                        coverage gate in build/Build.Architecture.cs fails the build,
                                        and that is deliberate.
        CyberCloud.Tenancy              TenantDirectoryCache — the in-process snapshot stage 3 reads.
        CyberCloud.ResourceManager      Stage 8 dispatches to it. docs/plan/08 calls it "a service
                                        held by the gateway".
        CyberCloud.Identity.Contracts   AccessTokenClaims and AccessTokenPolicy — the claim names,
                                        the audience and the algorithm a token carries, stated once
                                        so the identity host and this validator cannot drift. ⚠ It
                                        references CyberCloud.Authorization.Contracts, and that is
                                        fine for the reason the ABSENT list below gives: no type from
                                        it is bound here, so no AssemblyRef row appears.
        OpenIddict.Validation.SystemNetHttp
                                        Stage 2. Validates a bearer JWT against the identity host's
                                        published key set — discovery, JWKS, signature, issuer,
                                        audience, expiry — from JwksCallerContextResolver.
        Providers.*.Application         ⚠ TWELVE OF THEM, AND RULE 5 IS WHAT MAKES THEM LEGAL —
                                        "the gateway references no provider IMPLEMENTATION assembly,
                                        only .Contracts and .Application". Stage 6 resolves a path
                                        against IProviderRegistry, the registry is built from the
                                        IResourceProvider instances in this process's container, and
                                        each of these modules puts one there. Without them this host
                                        composed the resource manager, built a registry from an empty
                                        set, and answered 404 to every resource and action path with
                                        nothing in the log — which is what it shipped as.

      What is deliberately ABSENT:

        CyberCloud.Authorization.Contracts — the gateway must not be able to NAME ICheckGrain.
          docs/plan/07 § The enforcement seam puts authorization in exactly one place, inside the
          resource manager. The reference is absent transitively too: CyberCloud.ResourceManager
          references it, but a transitive reference produces no AssemblyRef row unless a type is
          actually bound, and GatewayIsolationTests asserts the row is not there. That assertion is
          the machine-checked form of "the gateway performs no authorization itself".

        Any EF Core / Npgsql / DbContext package — docs/plan/10 § What the gateway must never do:
          "a gateway with a DbContext is a second write path within a year". Also asserted.

        Any SignalR backplane package — docs/plan/10 § SignalR: "No SignalR backplane product." The
          fan-out is a connection grain plus Orleans streams, which is O(interested), not O(pods).

        OpenIddict.Server.* — docs/plan/11 § Hosts: the gateway serves bearer tokens and mints none.
          The identity host is the mirror image (it references Server and not Validation), and the
          two reference sets are the package-level expression of the cookie-versus-bearer boundary.
          Nor OpenIddict.Validation.AspNetCore, which is an ASP.NET Core authentication handler;
          stage 2 is not one, and a scheme nothing consults is a second place authentication appears
          to happen.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <IsPublishable>true</IsPublishable>
        <!--
          CA1515 — "an application's API isn't typically referenced from outside the assembly". The
          reason it is wrong here is the hub classes, which SignalR instantiates by type.
          Directory.Build.targets grants InternalsVisibleTo to the sibling test project, so everything
          that does not have that reason stays internal.

          ⚠ It used to say "IConnectionGrain and its wire types are an Orleans grain contract, which
          the runtime and a silo both bind by name" — which was true of the type and false of its
          location: a silo cannot bind a type declared only in an Orleans client's assembly. Both have
          moved to CyberCloud.ResourceManager(.Contracts).
        -->
        <NoWarn>$(NoWarn);CA1515</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- ASP.NET Core, SignalR server, the health-check abstractions. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <!-- IGrainFactory.ForTenant. Every grain reference in this assembly goes through it. -->
        <PackageReference Include="Orleans.Multitenant"/>
        <!--
          ⚠ Microsoft.Orleans.Server IS DELIBERATELY ABSENT, AND IT USED TO BE HERE.
          It was referenced for one reason: ConnectionGrain derived from Orleans' `Grain`. That grain
          is a grain, and this host is an Orleans CLIENT (docs/plan/10 § Shape, "not a silo") — so no
          silo could ever have activated it. IConnectionGrain and its implementation now live in
          CyberCloud.ResourceManager(.Contracts), where a silo composes them, and this project has
          nothing left that needs the server assembly. GatewayIsolationTests
          .TheGatewayDeclaresNoGrainInterfaceAndNoGrainImplementation is the gate; this line's absence
          is the second, cheaper one.
        -->
        <!--
          Stage 5's counters. docs/plan/10 § Request pipeline: "Redis-backed sliding window". The
          counters themselves live in CyberCloud.ServiceDefaults.RateLimiting since #94, so the
          identity host can count through them too; this reference is for the IConnectionMultiplexer
          the registration keys on — Redis when a deployment registered one, in process otherwise.
        -->
        <PackageReference Include="StackExchange.Redis"/>
        <!--
          ⚠ OpenIddict.Validation.SystemNetHttp IS NO LONGER REFERENCED HERE DIRECTLY, AND THE
          BOUNDARY IT EXPRESSED IS UNCHANGED. Stage 2's validator moved to
          CyberCloud.Identity.Validation (below) when the feeds host needed the same one; that
          assembly carries the package, and this host still binds Validation and never Server. The
          header's "Validation and never Server" is now a statement about that assembly's reference
          set plus this one's, and GatewayIsolationTests' package assertions read the closure.
        -->
        <PackageReference Include="Volo.Abp.Autofac"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../CyberCloud.ServiceDefaults/CyberCloud.ServiceDefaults.csproj"/>
        <ProjectReference Include="../../CyberCloud.Tenancy/CyberCloud.Tenancy.csproj"/>
        <ProjectReference Include="../../CyberCloud.ResourceManager/CyberCloud.ResourceManager.csproj"/>
        <!--
          #36 — the agent tunnel's gateway half. AgentTunnelRelay admits an agent through
          IAgentTunnelGrain and relays its socket; it lives in CyberCloud.Kubernetes rather than here
          because the gateway may not call IGrainFactory.GetGrain without ForTenant
          (GatewayIsolationTests.NoGatewaySourceFileTakesAGrainReferenceWithoutForTenant) and a
          tunnel grain is null-tenant. ⚠ No k8s.* type is bound from it: the relay speaks
          TunnelFrame, and rule 3 stays true — the Architecture gate reads the AssemblyRef table.
        -->
        <ProjectReference Include="../../CyberCloud.Kubernetes/CyberCloud.Kubernetes.csproj"/>
        <!--
          The token contract — docs/plan/11 § Protocol's claim set, audience and algorithm, in the
          form both hosts compile against. AccessTokenPolicy's own remarks: "a change to any of it
          is a compile-time event on both sides rather than a message somebody missed".
        -->
        <ProjectReference Include="../../CyberCloud.Identity.Contracts/CyberCloud.Identity.Contracts.csproj"/>
        <!--
          Stage 2. docs/plan/11 § Protocol: "the gateway validates the JWT locally against the
          published key set". JwksBearerTokenValidator, shared with CyberCloud.Registry.Feeds.Host
          (docs/plan/13 § Artifact feeds) — the one place a platform token is turned into claims.
          It references OpenIddict.Validation.SystemNetHttp and never OpenIddict.Server.*, which is
          the header's boundary carried one assembly down.
        -->
        <ProjectReference Include="../../CyberCloud.Identity.Validation/CyberCloud.Identity.Validation.csproj"/>
        <!--
          docs/plan/18's OpenBao client. The reference is here rather than on CyberCloud.Silo.Host
          because THIS host is the one that composes the resource manager, and a synchronous action —
          `listKeys` — is served inside ResourceManagerService.ActionAsync in this process. Program.cs
          calls AddOpenBaoSecretResolver only when CyberCloud:Vault is configured; without it the
          refusing seams stay, which is a supported shape.
        -->
        <ProjectReference Include="../../CyberCloud.Vault/CyberCloud.Vault.csproj"/>
        <!--
          docs/plan/08 § The resource-graph projection (#54) — the resource-changed PUBLISHER and
          the QUERY API, and never the projector. ResourceManagerService emits step 11's event in
          THIS process, so the NATS sink has to be registered here for any event to reach the
          stream; stage 8 dispatches POST /tenants/{t}/providers/CyberCloud.ResourceGraph/resources
          to the ClickHouse-backed IResourceGraphQuery, which reads the projection from this process
          too. The projector that fills the table runs on the silos, because it reads a tenant's
          check grain for every row. GatewayComposition calls AddResourceChangedPublisher when
          CyberCloud:ResourceGraph (or Aspire's ConnectionStrings:nats) carries a NATS URL and
          AddResourceGraphQuery when it carries a ClickHouse endpoint; either alone is a supported
          shape. ⚠ No Kusto.Language or ClickHouse type is bound here — the module holds both —
          and no CyberCloud.Authorization.Contracts type either: the caller's usersets are read
          inside the module, behind IResourceGraphQuery, which keeps the ABSENT list below true.
        -->
        <ProjectReference Include="../../CyberCloud.ResourceGraph/CyberCloud.ResourceGraph.csproj"/>
        <!--
          docs/plan/17's sending domain, for the same reason CyberCloud.Vault is here: four of
          CyberCloud.Communication/services' synchronous actions — send, status, checkSuppression,
          listSuppressions — are served inside ResourceManagerService.ActionAsync in THIS process, and
          their handlers hold the module's two client-side seams. AddCyberCloudCommunicationClient
          registers them over this host's cluster client; nothing here hosts a grain.
        -->
        <ProjectReference Include="../../CyberCloud.Communication/CyberCloud.Communication.csproj"/>
    </ItemGroup>

    <!--
      ── Every provider module, the same twelve the silo loads ───────────────────────────────────

      ⚠ THE .Application PROJECT AND NEVER THE IMPLEMENTATION, which is rule 5 stated as a build
      graph. Each of these references its own provider implementation, so the implementations do end
      up in this host's restore closure — and that is not what rule 5 or GatewayIsolationTests are
      about. Both read the AssemblyRef table, into which Roslyn writes a row only for an assembly this
      one BINDS a type from, and the only type bound here is the module. That is the same distinction
      that keeps CyberCloud.Authorization.Contracts out of the gateway while
      CyberCloud.ResourceManager references it.

      ⚠ THIS LIST MUST MATCH CyberCloud.Silo.Host'S, LINE FOR LINE. The gateway routes from ITS
      registry; the silo reconciles from ITS container. A provider in one list and not the other is a
      resource type that either cannot be reached or never converges, and neither failure names the
      missing line. HostCompositionTests composes both and fails on the difference.
    -->
    <ItemGroup Label="The provider modules — docs/plan/03 § Assembly graph rules, rule 5">
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Analytics/CyberCloud.Providers.Analytics.Application/CyberCloud.Providers.Analytics.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.Application/CyberCloud.Providers.Cache.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Communication/CyberCloud.Providers.Communication.Application/CyberCloud.Providers.Communication.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Compute/CyberCloud.Providers.Compute.Application/CyberCloud.Providers.Compute.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.ContainerInstance/CyberCloud.Providers.ContainerInstance.Application/CyberCloud.Providers.ContainerInstance.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.ContainerRegistry/CyberCloud.Providers.ContainerRegistry.Application/CyberCloud.Providers.ContainerRegistry.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.ContainerService/CyberCloud.Providers.ContainerService.Application/CyberCloud.Providers.ContainerService.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.DBforMySQL/CyberCloud.Providers.DBforMySQL.Application/CyberCloud.Providers.DBforMySQL.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL.Application/CyberCloud.Providers.DBforPostgreSQL.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.DocumentDB/CyberCloud.Providers.DocumentDB.Application/CyberCloud.Providers.DocumentDB.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Mail/CyberCloud.Providers.Mail.Application/CyberCloud.Providers.Mail.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.Application/CyberCloud.Providers.Messaging.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Monitor/CyberCloud.Providers.Monitor.Application/CyberCloud.Providers.Monitor.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Network/CyberCloud.Providers.Network.Application/CyberCloud.Providers.Network.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Application/CyberCloud.Providers.Sample.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search.Application/CyberCloud.Providers.Search.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.Application/CyberCloud.Providers.Storage.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.RecoveryServices/CyberCloud.Providers.RecoveryServices.Application/CyberCloud.Providers.RecoveryServices.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Terminal/CyberCloud.Providers.Terminal.Application/CyberCloud.Providers.Terminal.Application.csproj"/>
    </ItemGroup>

    <ItemGroup Label="RFC 9116 security.txt — embedded so the build can see it expire">
        <!--
          Embedded rather than copied to the output directory or read from a ConfigMap, because the
          Expires line is gated: SecurityTxtTests.ExpiresIsAtLeastThirtyDaysOut reads this exact
          resource and fails the build thirty days before the file lapses. A file the gateway read
          at start-up would be one the build could not see. WellKnown/SecurityTxt.cs reads it by the
          logical name below; change one and change the other.
        -->
        <EmbeddedResource Include="WellKnown/security.txt" LogicalName="security.txt"/>
    </ItemGroup>

    <ItemGroup Label="CyberCloud.Analyzers — CC1006 is the reason this project exists in the gate">
        <ProjectReference Include="../../CyberCloud.Analyzers/CyberCloud.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
