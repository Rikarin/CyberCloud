<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/24 § Phase 0's exit criterion, as a test rather than as an instruction.
  
      ⚠ THIS SUITE STARTS THE REAL APPHOST. Not a re-implementation of it, not a TestCluster shaped
      like it: `DistributedApplicationTestingBuilder.CreateAsync<…>` runs CyberCloud.AppHost's own
      Program.cs, which starts the real Redis, PostgreSQL, NATS and k3s containers and launches the
      two silo processes. A test that rebuilt the topology in-process would be a test of the test.
  
      ⚠ IT IS THEREFORE SLOW AND IT IS A PER-PR TEST ANYWAY. The alternative — moving it to the
      nightly E2E suite — would mean the one criterion Phase 0 is defined by is not checked on the
      changes most likely to break it, which are changes to the AppHost and to CreateSilo.

      ⚠ THAT SENTENCE OPENED WITH A CITATION TO A ROW THAT DOES NOT EXIST, UNTIL ISSUE #81: it read
      "docs/plan/23 § CI shape budgets `Test` at 3 minutes and this suite is a large fraction of it".
      Checked on 2026-09-05: § CI shape is a five-row table of WORKFLOWS and carries exactly one
      number, `pr.yml` at `≤ 25 min` for the whole pipeline. It has no per-target row. The three
      minutes exists a section earlier, in § Test layers, where it bounds the `Unit` LAYER — a
      different thing from the `Test` target, which runs every per-PR suite including the grain and
      reconciler layers that same table gives 12 and 15 minutes of their own.

      What actually bounds this suite: `.github/workflows/gate.yml` § `test` sets
      `timeout-minutes: 30`, which is a kill switch and not a budget, and
      `.github/workflows/pr.yml` § "Enforce the 25-minute budget" fails the pipeline past
      `BUDGET_MINUTES: 25` — six gate jobs in parallel, this suite inside one of them. The cost
      argument above is unaffected; only the number attached to it was wrong, which is the failure
      mode a citation to a section rather than to a line is supposed to make less likely and does
      not.
    -->

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="Aspire.Hosting.Testing"/>
        <!--
          ⚠ THE HALF OF THE PHASE-1 ASSERTION THAT IS DELIBERATELY NOT OUR CODE.
          ReconcileThroughTheRealHostTests reads the ConfigMap a widget produced with the raw
          KubernetesClient, straight against the k3s API server. Reading it back through
          IKubeClusterConnection would be asking the same code that wrote it — and the failure that
          costs is a plural or a namespace that only our own dictionary agrees with.

          KubernetesClient is otherwise confined to CyberCloud.Kubernetes on purpose; a test suite
          that verifies that assembly's output from outside is the exception the confinement is for.
        -->
        <PackageReference Include="KubernetesClient"/>
    </ItemGroup>

    <ItemGroup>
        <!--
          The AppHost is the system under test. Aspire.AppHost.Sdk's targets flow through this reference
          and generate the `Projects.CyberCloud_AppHost` metadata type the testing builder takes.
        -->
        <ProjectReference Include="../CyberCloud.AppHost/CyberCloud.AppHost.csproj"/>
        <!-- IHelloGrain and its generated client proxy. -->
        <ProjectReference Include="../CyberCloud.Silo.Host/CyberCloud.Silo.Host.csproj"/>
        <!--
          ⚠ THE GATEWAY IS UNDER TEST HERE, NOT A STAND-IN FOR ONE.

          docs/plan/24 § Phase 1's exit criterion is a resource driven from PUT to Succeeded, and the
          PUT enters the platform through IResourceManager — a plain service the GATEWAY holds, not a
          grain (see IResourceManager's remarks). ReconcileThroughTheRealHostTests therefore calls
          GatewayComposition.BuildAsync, which is what CyberCloud.Gateway.Host's own Program.cs calls,
          and resolves the manager from the container that produced. Constructing
          ResourceManagerService in the test instead would let the test choose the authorizer, the
          lock resolver and the registry — which is exactly what every conformance suite does and what
          this one exists not to do.

          It also carries CyberCloud.ResourceManager.Contracts, CyberCloud.Authorization.Contracts,
          CyberCloud.Kubernetes.Contracts and CyberCloud.Providers.Sample.Contracts transitively, so
          the wire types the test names come from the same build the hosts run.
        -->
        <ProjectReference Include="../CyberCloud.Gateway.Host/CyberCloud.Gateway.Host.csproj"/>
    </ItemGroup>

    <ItemGroup Label="Global usings">
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
