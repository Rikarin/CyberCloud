<Project Sdk="Microsoft.NET.Sdk">

    <!--
      docs/plan/03 § Hosts: "CyberCloud.Silo.Host/  # the Orleans silo — loads every provider module".

      ⚠ IT NOW DOES, AND UNTIL IT DID, NOTHING IN THIS PLATFORM RECONCILED ANYTHING. This project's
      reference set was ServiceDefaults, Tenancy, Communication and Identity: no CyberCloud.ResourceManager,
      so OperationGrain, ResourceGrain and ConnectionGrain were in no silo's manifest, and no provider
      module at all, so `AddCyberCloudProvider` had zero callers across the whole repository. Sixteen
      resource types across twelve providers had nowhere to execute, and every conformance suite was
      green because each one builds its own TestCluster and registers the manager and a provider itself.
      docs/plan/24's M1 exit story could not have run in this process.

      What it has beyond that is the whole of docs/plan/04 § Silo composition that exists today —
      CreateSilo, the two storage tiers, the tenancy grains and the cross-tenant separation — plus the
      one-shot `apply-durable-schema` mode (see Program.cs), which is the thing that makes a fresh
      PostgreSQL shard usable at all.
    -->

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!--
          The Aspire AppHost references this project and the generated `Projects.CyberCloud_Silo_Host`
          metadata is how it launches it. Nothing else about this project is Aspire-aware: it reads
          plain configuration, so `dotnet run` on it directly with a `CyberCloud__Storage__…`
          environment works identically. ADR-014 — Aspire is the local orchestrator, not a dependency.
        -->
        <IsPublishable>true</IsPublishable>
        <!--
          CA1515 — "an application's API isn't typically referenced from outside the assembly". It is
          here, twice over, and both are deliberate: the Aspire AppHost takes a `Projects.*` handle to
          this project, and CyberCloud.AppHost.Tests calls IHelloGrain through a real Orleans client, so
          the grain interface and its wire types have to be public. Directory.Build.targets' automatic
          InternalsVisibleTo covers only `CyberCloud.Silo.Host.Tests`, which is not the suite that
          exercises this host — the exit criterion belongs to the AppHost, not to the silo.
        -->
        <NoWarn>$(NoWarn);CA1515</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../CyberCloud.ServiceDefaults/CyberCloud.ServiceDefaults.csproj"/>
        <ProjectReference Include="../../CyberCloud.Tenancy/CyberCloud.Tenancy.csproj"/>
        <!--
          docs/plan/17's sending domain. Orleans DISCOVERS grains by scanning referenced assemblies,
          so this line is what puts CyberCloud.Communication's seven grain types in the silo; the
          AddCyberCloudCommunication() call in Program.cs is what registers the services their
          constructors ask for. Either one without the other is a silo that fails at the first
          activation rather than at start-up.
        -->
        <ProjectReference Include="../../CyberCloud.Communication/CyberCloud.Communication.csproj"/>
        <!--
          docs/plan/11's identity module. The same two-part arrangement as the line above and for the
          same reason: Orleans DISCOVERS grains by scanning referenced assemblies, so this line is
          what puts IUserGrain, IGroupGrain, ISessionGrain, IApplicationGrain,
          IServicePrincipalGrain and IManagedIdentityGrain in the silo, and the AddSiloIdentity()
          call in Program.cs is what registers the services their constructors ask for.

          ⚠ ITS ABSENCE WAS LOAD-BEARING IN THE WRONG DIRECTION. Until this line existed, no silo in
          src/Hosts composed the identity module, so AddCyberCloudIdentity had exactly one caller in
          the tree and that caller was a test fixture — which meant UnavailableOtpDelivery's
          operator-facing message was written, tested, and unreachable in production.
        -->
        <ProjectReference Include="../../CyberCloud.Identity/CyberCloud.Identity.csproj"/>
        <!--
          docs/plan/08's write path and reconcile loop. The same two-part arrangement again, and this
          is the one whose absence was the largest gap in the repository: Orleans DISCOVERS grains by
          scanning referenced assemblies, so THIS line is what puts OperationGrain, ResourceGrain and
          ConnectionGrain in the silo, and the AddCyberCloudResourceManager() call in Program.cs is what
          registers the write path, the reconcile driver and the seams their constructors ask for.

          ⚠ IT IS HERE BECAUSE THIS HOST NAMES AddCyberCloudResourceManager, NOT BECAUSE THE GRAINS
          WOULD OTHERWISE BE MISSING — and that distinction was checked rather than assumed. Deleting
          this line and rebuilding leaves ResourceGrain, OperationGrain and ConnectionGrain in the
          silo's grain manifest all the same: each provider module below reaches this assembly, and
          Orleans' generated ApplicationPart metadata travels through the transitive closure. So the
          reference is a direct one for the ordinary reason — SiloComposition binds a type from it —
          and NOT a load-bearing part of grain discovery.

          What is load-bearing is that some path reaches this assembly at all. HostCompositionTests
          .TheResourceManagerGrainsAreInTheSilosManifest asserts the outcome — the grain types are in
          GrainTypeOptions — rather than the reference, because a ProjectReference that satisfies the
          compiler and a grain the runtime can place are two different claims.
        -->
        <ProjectReference Include="../../CyberCloud.ResourceManager/CyberCloud.ResourceManager.csproj"/>
        <!--
          docs/plan/09's cluster fabric. AddCyberCloudKubernetes() in SiloComposition is what puts
          ClusterConnectionGrain in the silo and registers ClusterConnectionTenantFilter — the filter
          that establishes the caller tenant a null-tenant grain has nothing else to check against.

          ⚠ A HOST MAY TAKE THIS EDGE AND NOTHING ELSE MAY TAKE IT BACKWARDS. module-layering.txt
          carries CyberCloud.ResourceManager -> CyberCloud.Kubernetes, so the reverse would be a cycle
          and rule 7 refuses one; that is why GrainClusterConnectionRegistrar lives in the resource
          manager rather than beside ClusterConnectionHandle. Hosts are out of rule 7's scope, which
          is what makes composing both here legal and correct.
        -->
        <ProjectReference Include="../../CyberCloud.Kubernetes/CyberCloud.Kubernetes.csproj"/>
        <!--
          docs/plan/07's ReBAC engine, and its absence was step 3 of every write.

          ⚠ NOTHING IN src/Hosts REFERENCED THIS ASSEMBLY. AddCyberCloudResourceManager registers
          ReBacResourceAuthorizer and ReBacResourceRelationWriter — both real, both reached in
          production — and every call they make is to ICheckGrain, IObjectRelationsGrain,
          ISubjectRelationsGrain or ITupleStoreGrain, whose interfaces live in
          CyberCloud.Authorization.Contracts and whose IMPLEMENTATIONS live here. So the gateway
          composed an authorizer, the silo held no grain able to answer it, and the enforcement seam's
          own rule turned the resulting failure into the canonical 404: ReBacResourceAuthorizer logs
          "checking '{permission}' on '{path}' failed rather than answering" and returns
          ResourceNotFound. Every create through the real hosts answered 404 for a resource the caller
          was entitled to make, and the log line naming the reason was the only evidence.

          ⚠ THIS COULD NOT BE SEEN FROM ANY CONFORMANCE SUITE. ResourceManagerCluster and both halves
          of the provider conformance harness substitute the authorizer — SwitchableAuthorizer,
          PermissiveAuthorizer — so the ONLY thing that composes ReBacResourceAuthorizer against real
          grains is a production host, and no test started one until
          CyberCloud.AppHost.Tests/ReconcileThroughTheRealHostTests.cs.
        -->
        <ProjectReference Include="../../CyberCloud.Authorization/CyberCloud.Authorization.csproj"/>
    </ItemGroup>

    <!--
      ── Every provider module — docs/plan/04 § Silo composition ─────────────────────────────────

      "Every silo loads every provider module. There are no specialised silo roles." Each line below
      is one ABP module, pulled in by SiloHostModule's [DependsOn], whose ConfigureServices registers
      its provider, its reconcilers and its action handlers into the container the registry is built
      from.

      ⚠ NAMED ONE BY ONE RATHER THAN DISCOVERED. ProviderDiscovery exists and scans an assembly, and
      its own remarks forbid a silo using it: "a silo whose API surface depended on which assemblies
      happened to be next to it on disk would answer 404 for a provider somebody forgot to copy, with
      nothing in the log". A missing line here is a missing line in a diff.

      ⚠ THIS LIST AND CyberCloud.Gateway.Host'S MUST BE THE SAME LIST, and nothing about a
      ProjectReference makes that true. The gateway routes from ITS registry, so a provider here and
      not there is a type that reconciles and cannot be reached, and a provider there and not here is
      a type that accepts a create and never converges. HostCompositionTests compares the two
      composed registries and fails on the difference.
    -->
    <ItemGroup Label="The provider modules — docs/plan/03 § Providers">
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Analytics/CyberCloud.Providers.Analytics.Application/CyberCloud.Providers.Analytics.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.Application/CyberCloud.Providers.Cache.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.ContainerRegistry/CyberCloud.Providers.ContainerRegistry.Application/CyberCloud.Providers.ContainerRegistry.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.ContainerService/CyberCloud.Providers.ContainerService.Application/CyberCloud.Providers.ContainerService.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.DBforMySQL/CyberCloud.Providers.DBforMySQL.Application/CyberCloud.Providers.DBforMySQL.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL.Application/CyberCloud.Providers.DBforPostgreSQL.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.DocumentDB/CyberCloud.Providers.DocumentDB.Application/CyberCloud.Providers.DocumentDB.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.Application/CyberCloud.Providers.Messaging.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Monitor/CyberCloud.Providers.Monitor.Application/CyberCloud.Providers.Monitor.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Network/CyberCloud.Providers.Network.Application/CyberCloud.Providers.Network.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Application/CyberCloud.Providers.Sample.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search.Application/CyberCloud.Providers.Search.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.Application/CyberCloud.Providers.Storage.Application.csproj"/>
        <ProjectReference Include="../../Providers/CyberCloud.Providers.Terminal/CyberCloud.Providers.Terminal.Application/CyberCloud.Providers.Terminal.Application.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Volo.Abp.Autofac"/>
        <!--
          Reminders, on the hot tier's Redis — docs/plan/04 § Reminders. ⚠ THE PACKAGE IS HERE AND NOT
          IN CyberCloud.ServiceDefaults, which is where it was first put and where it was wrong.
          CreateSilo wires the two storage tiers whenever CyberCloud:Storage is configured, and
          "configured" is not "reachable": CyberCloud.ServiceDefaults.Tests'
          UnreachableShardReadinessFixture sets a hot-tier connection string and points it at nothing
          on purpose, so a reminder service wired on the same condition failed that fixture at
          start-up with a Redis connection error. Only a host knows whether its Redis is real.
        -->
        <PackageReference Include="Microsoft.Orleans.Reminders.Redis"/>
        <!-- ConfigurationOptions.Parse, for the line above. -->
        <PackageReference Include="StackExchange.Redis"/>
    </ItemGroup>

    <ItemGroup Label="CyberCloud.Analyzers — docs/plan/00 § Coding standards, § Non-negotiables">
        <!--
          OutputItemType="Analyzer" with ReferenceOutputAssembly="false": the analyzer joins the
          compiler's rule list and nothing from it reaches this assembly's metadata.

          A host is where CC1001 and CC1002 have the most room to do damage — startup code is
          synchronous, so `.Result` on a task is both easy to write and the exact shape that deadlocks
          a silo. HelloGrain also lives here, which puts the grain rules in scope. Enforced across the
          tree by the Analyzer coverage gate in build/Build.Architecture.cs.
        -->
        <ProjectReference Include="../../CyberCloud.Analyzers/CyberCloud.Analyzers.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
