{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Orleans": "Warning",
        "Volo.Abp": "Warning"
      }
    }
  },
  "CyberCloud": {
    "Feeds": {
      "PublicBaseUri": "https://feeds.cybercloud.io",
      "MaxArtifactBytes": 268435456,
      "Identity": {
        "Issuer": "https://id.cybercloud.io",
        "Audience": "cyc.api"
      }
    }
  },
  "AllowedHosts": "*"
}
