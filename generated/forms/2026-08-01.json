          "control": "xui-input",
          "type": "string",
          "required": false,
          "section": "storage",
          "hint": "Size of the separate write-ahead-log volume. Empty means the WAL shares the data volume.",
          "pattern": "^(?:(\\d+(\\.\\d+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?)?)$",
          "default": ""
        },
        {
          "jsonPointer": "/properties/synchronousReplication",
          "name": "synchronousReplication",
          "label": "Synchronous replication",
          "control": "xui-switch",
          "type": "boolean",
          "required": false,
          "section": "general",
          "hint": "Whether commits wait for a replica. Costs write latency and removes the window in which a failover loses transactions.",
          "default": false
        },
        {
          "jsonPointer": "/properties/version",
          "name": "version",
          "label": "Version",
          "control": "xui-select",
          "type": "string",
          "required": true,
          "section": "general",
          "hint": "Major PostgreSQL version. Minor upgrades are applied automatically in the maintenance window.",
          "choices": [
            {
              "value": "16",
              "label": "16"
            },
            {
              "value": "17",
              "label": "17"
            },
            {
              "value": "18",
              "label": "18"
            }
          ],
          "default": "17"
        },
        {
          "jsonPointer": "/tags",
          "name": "tags",
          "label": "Tags",
          "control": "xui-tag-input",
          "type": "object",
          "required": false,
          "section": "general",
          "hint": "Key/value tags, at most 50 pairs — docs/plan/06 § Tags, locks. Values are strings; the cap applies to the merged set, so a PATCH that adds one tag to a full bag is refused.",
          "maxProperties": 50
        }
      ],
      "actions": [
