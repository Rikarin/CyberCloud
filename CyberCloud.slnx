<Solution>
    <!--
      docs/plan/03 § Top level. The XML solution format (SDK 9.0.200+, the default in SDK 10).
  
      Verified on SDK 10.0.302: `dotnet sln CyberCloud.slnx list` and `dotnet build CyberCloud.slnx`
      both work, and a `.slnf` filter CAN name a `.slnx` in its "solution.path" — `dotnet sln <f>.slnf
      list` and `dotnet build <f>.slnf` were both exercised against this file with a real project in it.
  
      There are no <Project> entries yet — this repository currently contains build infrastructure
      only. The folders below are the shape the first assemblies drop into. Solution folders mirror
      the repository tree; add a project under the folder that matches its location on disk.
  
      ── Filter membership (docs/plan/03), recorded here because .slnf is strict JSON and rejects
         comments — verified: a `//` comment makes `dotnet sln … list` fail with
         "'/' is invalid after a value" ──
  
        CyberCloud.Core.slnf       src/CyberCloud.Core*, src/CyberCloud.Tenancy*,
                                   src/CyberCloud.Authorization*, src/CyberCloud.Kubernetes*,
                                   src/CyberCloud.Analyzers* (+ their .Tests siblings)
                                   — the fast IDE load. The analyzers are in this filter because
                                   every project in it references them, and an analyzer you cannot
                                   open is an analyzer you edit by guessing.
        CyberCloud.Providers.slnf  src/Providers/** (+ .Contracts/.Application/.Tests/.Conformance)
        CyberCloud.Hosts.slnf      src/Hosts/**
  
      All three filters are currently empty ("projects": []), which loads and builds cleanly. Populate
      each as its projects land — a filter naming a project that is not in this .slnx will not load.
    -->

    <Folder Name="/solution items/">
        <File Path=".editorconfig"/>
        <File Path=".gitignore"/>
        <File Path="Directory.Build.props"/>
        <File Path="Directory.Build.targets"/>
        <File Path="Directory.Packages.props"/>
        <File Path="global.json"/>
        <File Path=".config/dotnet-tools.json"/>
        <!--
          The reviewed list of grain types whose state is durable — docs/plan/05 § Choosing a tier,
          enforced by the Storage tier gate in build/Build.Architecture.cs. Here because a change to
          it is reviewed like a schema migration, and a file nobody can open from the solution is a
          file nobody reviews.
        -->
        <File Path="durable-grains.txt"/>
    </Folder>

    <Folder Name="/build/"/>

    <Folder Name="/src/">
        <!--
          ⚠ CyberCloud.Analyzers is the ONE netstandard2.0 project in the tree (docs/plan/02 § Platform
          baseline's single-TFM rule has this one documented exception — a Roslyn analyzer is loaded by
          the compiler, which may be running on .NET Framework). The five projects it polices reference
          it with OutputItemType="Analyzer", not as an ordinary reference.
        -->
        <Project Path="src/CyberCloud.Analyzers/CyberCloud.Analyzers.csproj"/>
        <Project Path="src/CyberCloud.Analyzers.Tests/CyberCloud.Analyzers.Tests.csproj"/>
        <Project Path="src/CyberCloud.Communication.Contracts/CyberCloud.Communication.Contracts.csproj"/>
        <Project Path="src/CyberCloud.Communication.Contracts.Tests/CyberCloud.Communication.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.Communication/CyberCloud.Communication.csproj"/>
        <Project Path="src/CyberCloud.Communication.Tests/CyberCloud.Communication.Tests.csproj"/>
        <Project Path="src/CyberCloud.Core/CyberCloud.Core.csproj"/>
        <Project Path="src/CyberCloud.Core.Tests/CyberCloud.Core.Tests.csproj"/>
        <Project Path="src/CyberCloud.Core.Contracts/CyberCloud.Core.Contracts.csproj"/>
        <Project Path="src/CyberCloud.Core.Contracts.Tests/CyberCloud.Core.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.ServiceDefaults/CyberCloud.ServiceDefaults.csproj"/>
        <Project Path="src/CyberCloud.ServiceDefaults.Tests/CyberCloud.ServiceDefaults.Tests.csproj"/>
        <Project Path="src/CyberCloud.Tenancy.Contracts/CyberCloud.Tenancy.Contracts.csproj"/>
        <Project Path="src/CyberCloud.Tenancy.Contracts.Tests/CyberCloud.Tenancy.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.Tenancy/CyberCloud.Tenancy.csproj"/>
        <Project Path="src/CyberCloud.Tenancy.Tests/CyberCloud.Tenancy.Tests.csproj"/>
        <Project Path="src/CyberCloud.Authorization.Contracts/CyberCloud.Authorization.Contracts.csproj"/>
        <Project Path="src/CyberCloud.Authorization.Contracts.Tests/CyberCloud.Authorization.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.Authorization/CyberCloud.Authorization.csproj"/>
        <Project Path="src/CyberCloud.Authorization.Tests/CyberCloud.Authorization.Tests.csproj"/>
        <Project Path="src/CyberCloud.Kubernetes.Contracts/CyberCloud.Kubernetes.Contracts.csproj"/>
        <Project Path="src/CyberCloud.Kubernetes.Contracts.Tests/CyberCloud.Kubernetes.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.Kubernetes/CyberCloud.Kubernetes.csproj"/>
        <Project Path="src/CyberCloud.Kubernetes.Tests/CyberCloud.Kubernetes.Tests.csproj"/>
        <Project Path="src/CyberCloud.Metering.Contracts/CyberCloud.Metering.Contracts.csproj"/>
        <Project Path="src/CyberCloud.Metering.Contracts.Tests/CyberCloud.Metering.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.Metering/CyberCloud.Metering.csproj"/>
        <Project Path="src/CyberCloud.Metering.Tests/CyberCloud.Metering.Tests.csproj"/>
        <Project Path="src/CyberCloud.ResourceManager.Contracts/CyberCloud.ResourceManager.Contracts.csproj"/>
        <Project Path="src/CyberCloud.ResourceManager.Contracts.Tests/CyberCloud.ResourceManager.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.ResourceManager/CyberCloud.ResourceManager.csproj"/>
        <Project Path="src/CyberCloud.ResourceManager.Tests/CyberCloud.ResourceManager.Tests.csproj"/>
        <!--
          ADR-012's generation step. An Exe, run by `./build.sh Generate` and by the Generated
          surfaces gate — never deployed. See its .csproj for why it is a separate process from the
          Nuke build rather than code inside it.
        -->
        <Project Path="src/CyberCloud.ResourceManager.Generator/CyberCloud.ResourceManager.Generator.csproj"/>
        <!--
          ⚠ The generator's suite drives Program.Main IN-PROCESS. docs/plan/23 § Test layers puts the
          ≥ 70 % coverage floor on every shipping project, and dotnet-coverage instruments the test
          host only — a generator started as a child process is one the instrumenter never sees, so a
          suite that exercised every line of it would still report 0 %. That is why the generator has
          an InternalsVisibleTo and an `internal` Main.
        -->
        <Project Path="src/CyberCloud.ResourceManager.Generator.Tests/CyberCloud.ResourceManager.Generator.Tests.csproj"/>

        <!-- docs/plan/11. The hosts live under /src/Hosts/ — cookies there, bearer at the gateway. -->
        <Project Path="src/CyberCloud.Identity.Contracts/CyberCloud.Identity.Contracts.csproj"/>
        <Project Path="src/CyberCloud.Identity.Contracts.Tests/CyberCloud.Identity.Contracts.Tests.csproj"/>
        <Project Path="src/CyberCloud.Identity/CyberCloud.Identity.csproj"/>
        <Project Path="src/CyberCloud.Identity.Tests/CyberCloud.Identity.Tests.csproj"/>
        <!--
          The hand-written half of the .NET SDK — docs/plan/21 § Generation. ⚠ It is the ONE project
          under src/ with IsPackable=true: docs/plan/03 § Top level keeps `cli/` out of src/ "because
          it ships separately" and places the SDK nowhere at all, which is a gap in that document
          rather than a decision. It is here because it is .NET library code the generator writes
          into, and because Build.Publish's NuGet step wants one project rather than a fourth
          top-level tree.

          ⚠ Nothing named Azure.* is in its graph — docs/plan/21 § The .NET SDK, DECIDED 2026-08-11.
          Its only package is Polly, which was already in the register for the fabric.
        -->
        <Project Path="src/CyberCloud.Sdk/CyberCloud.Sdk.csproj"/>
        <Project Path="src/CyberCloud.Sdk.Tests/CyberCloud.Sdk.Tests.csproj"/>

        <!--
          docs/plan/18 § CyberCloud.KeyVault/vaults — the platform's OpenBao client and the one
          ISecretResolver that returns a value. ⚠ No .Contracts pair, and the absence is the design:
          it implements an interface that already exists in CyberCloud.ResourceManager.Contracts, so
          a contracts assembly of its own would only be a second place to declare a seam. ⚠ The
          assembly name is fixed by CC1005 — CyberCloud.Analyzers/WellKnown.cs's VaultAssembly is the
          exemption, matched exactly or by dotted prefix.
        -->
        <Project Path="src/CyberCloud.Vault/CyberCloud.Vault.csproj"/>
        <Project Path="src/CyberCloud.Vault.Tests/CyberCloud.Vault.Tests.csproj"/>
    </Folder>
    <!--
      docs/plan/03 § Providers — the five projects every provider has. CyberCloud.Sample is the first
      and, per docs/plan/24 § Phase 1's exit criterion 1 and docs/plan/25 § R1, is deliberately
      trivial: it exists to measure the platform, not to be a feature.

      ⚠ Its arrival made two assembly-graph rules non-vacuous. Rule 2 ("no Providers.* assembly
      references another Providers.* assembly") and rule 4 ("nothing references a *.Application
      assembly except its own host") had zero candidates and passed vacuously.

      ⚠ CyberCloud.Providers.DBforPostgreSQL is the SECOND FAMILY, and that is what makes rule 2
      VIOLABLE rather than merely non-vacuous. Rule 2 is read as cross-provider — a provider
      referencing its OWN .Contracts is its internal seam — so with one family in the tree the rule
      had three candidates and no constructible violation: there was no second family to reference.
      There is now, and docs/plan/12 § The catalogue has nine more.
    -->
    <Folder Name="/src/Providers/">
        <Project Path="src/Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Contracts/CyberCloud.Providers.Sample.Contracts.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Application/CyberCloud.Providers.Sample.Application.csproj"/>
        <!--
          ⚠ A sixth project in a folder docs/plan/03 § Providers describes with five, and it is a
          suite rather than a provider part. Rule 4 ("nothing references a *.Application assembly
          except its own host") is not violated by it and does not need an exemption: rule 4 runs over
          Build.Architecture.cs § ShippingAssemblies, which is every project where SuiteOwning is
          null, and a *.Tests project is claimed by the per-PR suite.
        -->
        <Project Path="src/Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Application.Tests/CyberCloud.Providers.Sample.Application.Tests.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Tests/CyberCloud.Providers.Sample.Tests.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Conformance/CyberCloud.Providers.Sample.Conformance.csproj"/>
        <!--
          The cluster-backed half of the same suite — two class declarations over the same
          ProviderConformanceCase, in a project that may depend on a Docker daemon because the one
          above must not. See its .csproj.
        -->
        <Project Path="src/Providers/CyberCloud.Providers.Sample/CyberCloud.Providers.Sample.Cluster.Conformance/CyberCloud.Providers.Sample.Cluster.Conformance.csproj"/>

        <!--
          The second provider family, and the first one that is a feature rather than a measurement.
          Its arrival is what made assembly-graph rule 2 non-vacuous: with only Sample in the tree,
          Sample, Sample.Contracts and Sample.Application were all one family, so the rule had
          candidates and no constructible violation.

          ⚠ It has no *.Cluster.Conformance sibling yet. That is a gap, not a decision — the two
          projects are class declarations over one ProviderConformanceCase, so adding it is cheap.
          ⚠ AND IT IS NOW CHEAPER THAN IT WAS, because the third family paid for the part that was
          not. Adding one would have failed against a bare k3s that serves no REST path for a
          CloudNativePG Cluster; ClusterConformanceHarness installs a minimal definition per custom
          kind now, derived from the case's own Objects, so this family needs no new declaration for
          it.
        -->
        <Project Path="src/Providers/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL.Contracts/CyberCloud.Providers.DBforPostgreSQL.Contracts.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL.Application/CyberCloud.Providers.DBforPostgreSQL.Application.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL.Tests/CyberCloud.Providers.DBforPostgreSQL.Tests.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.DBforPostgreSQL/CyberCloud.Providers.DBforPostgreSQL.Conformance/CyberCloud.Providers.DBforPostgreSQL.Conformance.csproj"/>

        <!--
          ⚠ THIS BLOCK CARRIED UNRESOLVED CONFLICT MARKERS UNTIL 2026-08-12, AND NOTHING NOTICED.
          `<<<<<<< HEAD` sat inside an XML comment and `=======` / `>>>>>>> …` sat as character data
          between two `<Project/>` elements, all of which is well-formed XML — so the solution parsed,
          both provider families were listed, and every gate stayed green over a file that says a
          merge is in progress. The sibling `CyberCloud.Providers.slnf` carried the same markers and
          was NOT well-formed, because it is JSON; nothing in the gate set reads it, which is why that
          one survived too. Both are resolved as the union, which is what the working tree already
          contained.

          The third provider family — CyberCloud.Cache/redis, docs/plan/12's second M1 row. Valkey
          rather than Redis (ADR-011), on spotahome/redis-operator (ADR-010 clause 1).

          ⚠ It is the first provider to arrive with all SIX projects, including the
          *.Cluster.Conformance the row above records as owed. That is not a courtesy: the shared
          cluster-backed suite is the only thing in this repository that applies a provider's rendered
          object to a real API server, and this is the first provider whose object is a CUSTOM
          RESOURCE whose CRD nothing installs. What that turned up is on the .csproj.
        -->
        <Project Path="src/Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.Contracts/CyberCloud.Providers.Cache.Contracts.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.Application/CyberCloud.Providers.Cache.Application.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.Tests/CyberCloud.Providers.Cache.Tests.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.Conformance/CyberCloud.Providers.Cache.Conformance.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Cache/CyberCloud.Providers.Cache.Cluster.Conformance/CyberCloud.Providers.Cache.Cluster.Conformance.csproj"/>

        <!--
          The fourth provider family — CyberCloud.Messaging/kafkaClusters on Strimzi and
          CyberCloud.Messaging/natsClusters, docs/plan/12 § The catalogue.

          ⚠ IT IS THE FIRST NAMESPACE WITH TWO RESOURCE TYPES IN IT, and the second type cost two case
          objects and four class declarations and no new project — which is what established that
          docs/plan/03's five-project shape is per NAMESPACE rather than per TYPE.
        -->
        <Project Path="src/Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.Contracts/CyberCloud.Providers.Messaging.Contracts.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.Application/CyberCloud.Providers.Messaging.Application.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.Tests/CyberCloud.Providers.Messaging.Tests.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.Conformance/CyberCloud.Providers.Messaging.Conformance.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Messaging/CyberCloud.Providers.Messaging.Cluster.Conformance/CyberCloud.Providers.Messaging.Cluster.Conformance.csproj"/>

        <!--
          The fifth provider family — CyberCloud.Storage/accounts on SeaweedFS.

          ⚠ IT IS THE FIRST PROVIDER WHOSE ROW IS NOT IN docs/plan/12. That document's catalogue is
          "databases, caches, brokers, search"; this one is
          docs/plan/15 § The three kinds — "Object · CyberCloud.Storage/accounts + /buckets ·
          SeaweedFS + S3 gateway" — and § Object storage, "M1 · 2.0 EM". docs/plan/12 owns the
          operator, through ADR-010 clause 1, and the eight pieces of § The pattern, once.

          ⚠ It closes the assumption charts/managed/postgres was already making: that chart renders a
          backup destination of s3://tenant-bucket/postgres against a provider that did not exist.
        -->
        <Project Path="src/Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.Contracts/CyberCloud.Providers.Storage.Contracts.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.Application/CyberCloud.Providers.Storage.Application.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.Tests/CyberCloud.Providers.Storage.Tests.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.Conformance/CyberCloud.Providers.Storage.Conformance.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Storage/CyberCloud.Providers.Storage.Cluster.Conformance/CyberCloud.Providers.Storage.Cluster.Conformance.csproj"/>

        <!--
          The sixth provider family — CyberCloud.Search/services on the OpenSearch operator.

          docs/plan/12 § The catalogue: "OpenSearch — CyberCloud.Search/services · M3 · 1.0 EM.
          OpenSearch operator (Apache-2.0, ADR-011 — Elasticsearch is not available to us).
          Data/master/coordinating node roles, ISM policies, snapshot repository into the tenant's
          bucket."

          ⚠ IT IS THE FIRST M3 ROW IN THE TREE, and structurally that changes nothing: four module
          edges, six projects, one ProviderConformanceCase. The milestone is a scheduling fact.

          ⚠ ADR-011 rather than ADR-010 is what picks the ENGINE here — Elasticsearch is SSPL — while
          ADR-010 clause 1's survey picks the operator. It is the only row in the catalogue whose two
          halves come from two different decision records.
        -->
        <Project Path="src/Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search.Contracts/CyberCloud.Providers.Search.Contracts.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search/CyberCloud.Providers.Search.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search.Application/CyberCloud.Providers.Search.Application.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search.Tests/CyberCloud.Providers.Search.Tests.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search.Conformance/CyberCloud.Providers.Search.Conformance.csproj"/>
        <Project Path="src/Providers/CyberCloud.Providers.Search/CyberCloud.Providers.Search.Cluster.Conformance/CyberCloud.Providers.Search.Cluster.Conformance.csproj"/>
    </Folder>
    <Folder Name="/src/Hosts/">
        <Project Path="src/Hosts/CyberCloud.Gateway.Host/CyberCloud.Gateway.Host.csproj"/>
        <Project Path="src/Hosts/CyberCloud.Gateway.Host.Tests/CyberCloud.Gateway.Host.Tests.csproj"/>
        <Project Path="src/Hosts/CyberCloud.Silo.Host/CyberCloud.Silo.Host.csproj"/>
        <Project Path="src/Hosts/CyberCloud.AppHost/CyberCloud.AppHost.csproj"/>
        <Project Path="src/Hosts/CyberCloud.AppHost.Tests/CyberCloud.AppHost.Tests.csproj"/>
        <Project Path="src/Hosts/CyberCloud.Identity.Host/CyberCloud.Identity.Host.csproj"/>
        <Project Path="src/Hosts/CyberCloud.Identity.Host.Tests/CyberCloud.Identity.Host.Tests.csproj"/>
    </Folder>
    <!--
      docs/plan/03 § Top level keeps `cli/` out of src/ because it ships separately.

      ⚠ The project is `cyc.csproj`, not `CyberCloud.Cli.csproj`, and the name is load-bearing:
      Directory.Build.props § "Assembly and namespace naming" derives AssemblyName from the project
      name, and build/Build.Architecture.cs § ShippingAssemblyPaths looks for
      artifacts/bin/<project>/<config>/<project>.dll. An AssemblyName override would leave every
      architecture gate reporting "no built assembly" for a project that built fine. Its
      RootNamespace is CyberCloud.Cli — see cyc.csproj.
    -->
    <Folder Name="/cli/">
        <Project Path="cli/cyc/cyc.csproj"/>
        <Project Path="cli/cyc.Tests/cyc.Tests.csproj"/>
    </Folder>

    <!--
      docs/plan/03 § test/ — the cross-cutting suites. Two of the five exist.

      ⚠ CyberCloud.Conformance is a test project AND a library other test projects reference — that is
      docs/plan/03's own description of it, "parameterised, referenced by providers". Both roles are
      live: it runs the suite against its own reference provider, and
      CyberCloud.Providers.Sample.Conformance references it to run the same suite against a real one.
    -->
    <Folder Name="/test/">
        <Project Path="test/CyberCloud.Conformance/CyberCloud.Conformance.csproj"/>
        <!--
          ⚠ The half of the conformance suite that needs Docker, and the reason it is a project of its
          own rather than a package added above: Testcontainers in CyberCloud.Conformance.csproj would
          make the WHOLE shared suite refuse to run without a daemon, and that suite is the per-PR gate
          for every provider change.

          ⚠ NOT named CyberCloud.Conformance.Cluster, which is the name its predecessor's skip messages
          gave. Directory.Build.props § Project role detection and build/Build.Test.cs § SuiteOwning both
          classify a project by the SUFFIX of its name; `.Cluster` is claimed by neither, so that name
          would have built as a library and then failed AssertEveryTestProjectIsOwned. Dual-role like
          CyberCloud.Conformance: it runs against the reference provider AND is referenced by each
          provider's own `.Cluster.Conformance` project.
        -->
        <Project Path="test/CyberCloud.Cluster.Conformance/CyberCloud.Cluster.Conformance.csproj"/>
        <Project Path="test/CyberCloud.Isolation/CyberCloud.Isolation.csproj"/>
    </Folder>
</Solution>
