# Cyber Cloud — editor and analyzer configuration.
#
# This file is the machine-readable form of docs/plan/00 § Coding standards. Where a rule in that
# section has no analyzer behind it, that is stated in a comment rather than papered over with a
# rule that only looks like it covers it.

root = true

# ══════════════════════════════════════════════════════════════════════════════════════════════
# Everything
# ══════════════════════════════════════════════════════════════════════════════════════════════
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,jsonc,yml,yaml,ts,js,mts,cts,html,scss,css,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{csproj,props,targets,slnx,slnf,xml,config,ruleset,nuspec}]
indent_size = 2

[*.{sh,bash}]
end_of_line = lf

[*.{cmd,bat,ps1}]
end_of_line = crlf

# ══════════════════════════════════════════════════════════════════════════════════════════════
# C#
# ══════════════════════════════════════════════════════════════════════════════════════════════
[*.cs]
indent_size = 4
tab_width = 4

# ───────────────────────────── using directives ─────────────────────────────
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning
dotnet_diagnostic.IDE0065.severity = warning

# ───────────────────────────── file-scoped namespaces ─────────────────────────────
# docs/plan/00 § Coding standards.
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error

# ───────────────────────────── accessibility modifiers ─────────────────────────────
# "Accessibility modifiers written only when they change something." — docs/plan/00.
# `omit_if_default` is exactly that rule: write `internal class`, not `private int field`.
dotnet_style_require_accessibility_modifiers = omit_if_default:warning
dotnet_diagnostic.IDE0040.severity = warning

# ───────────────────────────── sealed / internal by default ─────────────────────────────
# "sealed by default; internal by default, public needs a reason." — docs/plan/00.
#
# CA1852 seals internal types that are never inherited from. It is a real rule and it is on as an
# error, because an unsealed internal type is always an oversight.
dotnet_diagnostic.CA1852.severity = error
#
# CA1515 flags public types in a non-library project that could be internal. It is the closest
# existing rule to "public needs a reason". It is a warning, not an error, and Directory.Build.targets
# switches it off for *.Contracts and test projects, whose public surface is the point.
dotnet_diagnostic.CA1515.severity = warning
#
# ⚠ There is NO analyzer for "a *new* public type in a non-Contracts assembly needs a reason" as a
# design rule. CA1515 only fires where the compiler can prove nothing outside consumes the type,
# which is false for anything a host references. The assembly-graph rules in docs/plan/03 § Assembly
# graph rules are enforced by Build.Architecture, not by this file.

# ───────────────────────────── this. / Me. ─────────────────────────────
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error
dotnet_diagnostic.IDE0003.severity = error

# ───────────────────────────── var ─────────────────────────────
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# ───────────────────────────── expression / pattern preferences ─────────────────────────────
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_null_check_over_type_check = true:warning
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:warning
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning

dotnet_style_readonly_field = true:warning
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_propagation = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_auto_properties = true:warning
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
dotnet_style_prefer_compound_assignment = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:warning
dotnet_style_prefer_simplified_interpolation = true:warning
dotnet_style_namespace_match_folder = true:warning
dotnet_style_operator_placement_when_wrapping = beginning_of_line
csharp_style_prefer_utf8_string_literals = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_inlined_variable_declaration = true:warning
csharp_style_deconstructed_variable_declaration = true:suggestion
csharp_style_unused_value_expression_statement_preference = discard_variable:silent
csharp_style_unused_value_assignment_preference = discard_variable:warning

# ───────────────────────────── new lines / formatting ─────────────────────────────
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_indent_block_contents = true
csharp_indent_braces = false
csharp_indent_case_contents_when_block = false

csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_declaration_empty_parameter_list_parentheses = false
csharp_space_between_method_declaration_name_and_open_parenthesis = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_call_empty_parameter_list_parentheses = false
csharp_space_between_method_call_name_and_opening_parenthesis = false
csharp_space_between_parentheses = false
csharp_space_between_square_brackets = false
csharp_space_before_open_square_brackets = false
csharp_space_after_comma = true
csharp_space_before_comma = false
csharp_space_after_dot = false
csharp_space_before_dot = false
csharp_space_after_semicolon_in_for_statement = true
csharp_space_before_semicolon_in_for_statement = false
csharp_space_around_declaration_statements = false

csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true

# ══════════════════════════════════════════════════════════════════════════════════════════════
# Naming — docs/plan/00 § Coding standards:
#   "PascalCase for anything a caller can name; camelCase, no `_` prefix, for private state."
# ══════════════════════════════════════════════════════════════════════════════════════════════

dotnet_diagnostic.IDE1006.severity = error

# ── styles ──
dotnet_naming_style.pascal_case.capitalization = pascal_case

# camelCase with NO prefix. This is the deliberate departure from the Roslyn/.NET default of `_field`.
dotnet_naming_style.camel_case_no_prefix.capitalization = camel_case
dotnet_naming_style.camel_case_no_prefix.required_prefix =

dotnet_naming_style.interface_prefixed_with_i.capitalization = pascal_case
dotnet_naming_style.interface_prefixed_with_i.required_prefix = I

dotnet_naming_style.type_parameter_prefixed_with_t.capitalization = pascal_case
dotnet_naming_style.type_parameter_prefixed_with_t.required_prefix = T

dotnet_naming_style.all_upper_snake.capitalization = all_upper
dotnet_naming_style.all_upper_snake.word_separator = _

# ── symbol groups ──
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_symbols.nameable_symbols.applicable_kinds = class, struct, enum, delegate, property, method, event, namespace, local_function
dotnet_naming_symbols.nameable_symbols.applicable_accessibilities = *

dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, internal, protected, protected_internal, protected_friend

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = local, parameter
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

# ── rules (order matters: first match wins within a severity pass) ──
dotnet_naming_rule.interfaces_are_i_pascal.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_pascal.style = interface_prefixed_with_i
dotnet_naming_rule.interfaces_are_i_pascal.severity = error

dotnet_naming_rule.type_parameters_are_t_pascal.symbols = type_parameters
dotnet_naming_rule.type_parameters_are_t_pascal.style = type_parameter_prefixed_with_t
dotnet_naming_rule.type_parameters_are_t_pascal.severity = error

dotnet_naming_rule.constants_are_pascal.symbols = constants
dotnet_naming_rule.constants_are_pascal.style = pascal_case
dotnet_naming_rule.constants_are_pascal.severity = error

dotnet_naming_rule.static_readonly_are_pascal.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_are_pascal.style = pascal_case
dotnet_naming_rule.static_readonly_are_pascal.severity = error

# Anything a caller can name.
dotnet_naming_rule.nameable_are_pascal.symbols = nameable_symbols
dotnet_naming_rule.nameable_are_pascal.style = pascal_case
dotnet_naming_rule.nameable_are_pascal.severity = error

dotnet_naming_rule.non_private_fields_are_pascal.symbols = non_private_fields
dotnet_naming_rule.non_private_fields_are_pascal.style = pascal_case
dotnet_naming_rule.non_private_fields_are_pascal.severity = error

# Private state.
dotnet_naming_rule.private_fields_are_camel_no_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_no_underscore.style = camel_case_no_prefix
dotnet_naming_rule.private_fields_are_camel_no_underscore.severity = error

dotnet_naming_rule.locals_and_parameters_are_camel.symbols = locals_and_parameters
dotnet_naming_rule.locals_and_parameters_are_camel.style = camel_case_no_prefix
dotnet_naming_rule.locals_and_parameters_are_camel.severity = error

# ══════════════════════════════════════════════════════════════════════════════════════════════
# The docs/plan/00 bans, and exactly how far an existing analyzer takes each one
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
# docs/plan/00 § Coding standards: "No `async void`, no `.Result`, no `.Wait()` — analyzer-enforced.
# Grain code is single-threaded per activation and blocking it deadlocks the silo."
#
# ⚠ HONEST STATUS — none of the three is covered by a rule that ships with the .NET SDK:
#
#   * `async void`  — NO built-in rule. The rule people think of is VSTHRD100, which lives in
#                     Microsoft.VisualStudio.Threading.Analyzers, a package we do not reference.
#                     Adding that package pulls in ~20 other VSTHRD rules with their own opinions.
#                     STATUS: covered by CC1002 (src/CyberCloud.Analyzers).
#
#   * `.Result` / `.Wait()`
#                   — PARTIALLY covered by CA1849, which fires only when the blocking call appears
#                     inside a method that is *already* `async`. A synchronous method that calls
#                     `grain.DoAsync().Result` — the exact shape that deadlocks a silo — is NOT
#                     flagged by anything built in (that is VSTHRD002, same missing package).
#                     STATUS: CA1849 is on as an error below and keeps the async half; CC1001
#                     covers the synchronous half, and deliberately does not overlap it.
#
#   * `#pragma warning disable` without a linked issue (docs/plan/00 § Non-negotiables)
#                   — NO analyzer, built-in or otherwise. STATUS: covered by CC1007.
#
# ══════════════════════════════════════════════════════════════════════════════════════════════
# CyberCloud.Analyzers — CC1001..CC1007
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
# The paragraph that used to stand here said these rules "are the initial contents of a
# CyberCloud.Analyzers project. Until that exists, the bans are review-enforced." That project now
# exists (src/CyberCloud.Analyzers), and the five projects under src/ reference it with
# OutputItemType="Analyzer". Rule-by-rule documentation is in src/CyberCloud.Analyzers/Rules.cs;
# the plan citation for each is in its own analyzer file.
#
# ⚠ WHY EVERY ONE OF THEM IS `error`, AND WHY THAT IS A SMALLER DECISION THAN IT LOOKS.
#
# Directory.Build.props sets TreatWarningsAsErrors, so in this repository `warning` and `error` are
# the SAME outcome — a red build. The only real choice a severity makes here is between "breaks the
# build" (warning/error) and "does not" (suggestion/silent). Writing `error` says which of those two
# was chosen, rather than leaving a reader to work it out from a property in another file.
#
# ⚠ EACH WAS RUN OVER THE WHOLE TREE BEFORE BEING SET. All seven report ZERO hits on
# CyberCloud.Core, .Core.Contracts, .ServiceDefaults, .Tenancy.Contracts and .Tenancy — and two of
# them only after a genuine finding was fed back into the rule rather than into the code:
#
#   * CC1001 fired on HotTierConfigurator's `ContinueWith` continuation and on its guarded
#     `Dispose`. Neither blocks. Both are now tested exemptions.
#   * CC1006 fired on ClusterHealthCheck and SiloReadinessHealthCheck, which call
#     GetGrain<IManagementGrain>(0) — Orleans' own INTEGER-keyed system grain — from an IHealthCheck.
#     docs/plan/00 § Coding standards makes IGrainWithStringKey "the only key kind
#     Orleans.Multitenant can carry a tenant in", so a non-string-keyed grain cannot be a
#     cross-tenant read. The rule is scoped to string-keyed grains; read literally, the plan's
#     sentence bans two correct call sites.
#
# ⚠ ESCAPE HATCH, and it is deliberately not a #pragma. A rule that is right 99 times and wrong once
# needs a way to say so; use [SuppressMessage("<category>", "CC100n", Justification = "…")] with the
# argument written out. CC1007 polices `#pragma warning disable` and does not police
# [SuppressMessage], because an attribute carries a Justification field and a pragma carries nothing.
# CC1005's `*Key` suffix is the one most likely to need this — `PartitionKey` is not a secret, and
# making somebody write down why is the point.

dotnet_diagnostic.CC1001.severity = error   # blocking on a task from a synchronous method
dotnet_diagnostic.CC1002.severity = error   # async void
dotnet_diagnostic.CC1003.severity = error   # [GenerateSerializer] with no [Alias]
dotnet_diagnostic.CC1004.severity = error   # a grain-key literal containing the tenant separator
dotnet_diagnostic.CC1005.severity = error   # an [Id] member named *Password/*Secret/*Token/*Key
dotnet_diagnostic.CC1006.severity = error   # raw IGrainFactory.GetGrain outside grain code
dotnet_diagnostic.CC1007.severity = error   # #pragma warning disable with no linked issue

# What IS covered, and is therefore an error:
dotnet_diagnostic.CA1849.severity = error   # Call async methods when in an async method (partial .Result/.Wait cover)
dotnet_diagnostic.CA2007.severity = none    # ConfigureAwait — irrelevant: no sync context in a silo or a minimal host
dotnet_diagnostic.CA2008.severity = error   # Do not create tasks without passing a TaskScheduler
dotnet_diagnostic.CA2012.severity = error   # Use ValueTasks correctly
dotnet_diagnostic.CA2016.severity = error   # Forward the CancellationToken
dotnet_diagnostic.CS4014.severity = error   # Un-awaited call — the compiler's own async-void-adjacent catch
dotnet_diagnostic.CS1998.severity = error   # async method without await

# docs/plan/00 § Coding standards: "No interpolated log strings, ever."
# CA2254 fires on a non-constant logging message template, which is the interpolated-string case.
# ⚠ It does NOT enforce "use [LoggerMessage] source-generated methods" — that half is review-enforced.
dotnet_diagnostic.CA2254.severity = error
dotnet_diagnostic.CA2253.severity = error

# Nullable — docs/plan/00 § Non-negotiables: "nullable enabled".
dotnet_diagnostic.CS8600.severity = error
dotnet_diagnostic.CS8602.severity = error
dotnet_diagnostic.CS8603.severity = error
dotnet_diagnostic.CS8604.severity = error
dotnet_diagnostic.CS8618.severity = error
dotnet_diagnostic.CS8625.severity = error

# Dead code and unused state — cheap and always a real finding.
dotnet_diagnostic.IDE0005.severity = error  # unnecessary using
dotnet_diagnostic.IDE0044.severity = error  # make field readonly
dotnet_diagnostic.IDE0051.severity = error  # unused private member
dotnet_diagnostic.IDE0052.severity = error  # unread private member
dotnet_diagnostic.CS0168.severity = error   # declared, never used
dotnet_diagnostic.CS0219.severity = error   # assigned, never used

# Correctness rules worth being errors rather than warnings.
dotnet_diagnostic.CA1062.severity = none    # public-argument null checks — nullable annotations do this job
dotnet_diagnostic.CA1305.severity = error   # specify IFormatProvider
dotnet_diagnostic.CA1310.severity = error   # StringComparison on culture-sensitive compare
dotnet_diagnostic.CA1848.severity = suggestion  # use LoggerMessage delegates — the goal, but too loud as an error today
dotnet_diagnostic.CA2201.severity = error   # do not raise reserved exception types
dotnet_diagnostic.CA2213.severity = error   # disposable fields disposed
dotnet_diagnostic.CA2215.severity = error   # Dispose should call base.Dispose

# ── Rules demoted because they break trivially correct code under TreatWarningsAsErrors ──
# Each of these was OBSERVED failing a build of ordinary, defect-free code during repo bring-up.
#
# CA1873 fired on `logger.LogDebug("Cache hit for {ThingId}", id)` with a Guid argument — the exact
# shape docs/plan/00 asks for (constant template, structured argument). Its heuristic treats any
# boxed argument as "may be expensive". The real answer is [LoggerMessage] (CA1848, suggestion above);
# an error here would ban idiomatic ILogger calls before a single source-generated method exists.
dotnet_diagnostic.CA1873.severity = suggestion
#
# CA1822 fired on an ordinary instance helper that happens not to touch a field. It is a legitimate
# nudge and a terrible build gate: it makes "add a private helper" a compile error until you also
# decide its staticness, and it churns whenever a method stops using a field.
dotnet_diagnostic.CA1822.severity = suggestion

# Style rules that are noise as build errors: they fire on shape, not on defects, and with
# TreatWarningsAsErrors they stop a correct file compiling. Kept visible in the IDE only.
dotnet_diagnostic.IDE0011.severity = suggestion  # add braces
dotnet_diagnostic.IDE0022.severity = silent      # expression-bodied method
dotnet_diagnostic.IDE0045.severity = silent      # conditional expression over assignment
dotnet_diagnostic.IDE0046.severity = silent      # conditional expression over return
dotnet_diagnostic.IDE0058.severity = silent      # expression value never used
dotnet_diagnostic.IDE0072.severity = silent      # add missing cases to switch expression
dotnet_diagnostic.IDE0130.severity = suggestion  # namespace does not match folder structure

# ══════════════════════════════════════════════════════════════════════════════════════════════
# Generated code — the generator owns it (docs/plan/03 § Assembly graph rules, rule 6; ADR-012)
# ══════════════════════════════════════════════════════════════════════════════════════════════
[*.{g,generated,Designer}.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[**/obj/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

# ══════════════════════════════════════════════════════════════════════════════════════════════
# references/ — read-only, never built, never restored (docs/plan/03)
# ══════════════════════════════════════════════════════════════════════════════════════════════
#
# There is deliberately no [references/**] section here. `dotnet_analyzer_diagnostic.severity = none`
# would NOT have been enough: it silences analyzer (CA/IDE) rules but not compiler (CS) diagnostics,
# and the explicit `dotnet_diagnostic.CS0219.severity = error` above would still have applied.
# Verified: a reference project failed with `error CS0219` under exactly that arrangement.
#
# The barrier that works is references/.editorconfig with `root = true`, which terminates
# EditorConfig's upward search — the EditorConfig counterpart to references/Directory.Build.props.
